{
  "source": "Claude Code 2.1.312 REA + live macOS keychain metadata 2026-10-31",
  "configDir": {
    "env": "CLAUDE_CONFIG_DIR",
    "default": "~/.claude",
    "normalize": "NFC"
  },
  "secureStorageDir": {
    "env": "CLAUDE_SECURESTORAGE_CONFIG_DIR",
    "fallback": "configDir"
  },
  "plaintext": {
    "file": ".credentials.json",
    "path": "<secureStorageDir>/.credentials.json",
    "warning": "Warning: Storing credentials in plaintext."
  },
  "keychain": {
    "platform": "darwin",
    "class": "genp",
    "serviceTemplate": "Claude Code${OAUTH_FILE_SUFFIX}${suffix}${optionalConfigHash}",
    "oauthFileSuffixProd": "",
    "suffix": "-credentials",
    "serviceDefault": "Claude Code-credentials",
    "account": {
      "prefer": "USER",
      "fallback": "os.userInfo().username",
      "sanitizedFallback": "claude-code-user",
      "allowedPattern": "^[a-zA-Z0-9._-]+$"
    },
    "configHash": {
      "when": "CLAUDE_CONFIG_DIR is set and CLAUDE_SECURESTORAGE_CONFIG_DIR is unset",
      "value": "-${sha256(configDir).hex[0:8]}"
    },
    "commands": {
      "read": ["security", "find-generic-password", "-a", "<account>", "-w", "-s", "<service>"]
    }
  },
  "payload": {
    "topLevelKey": "claudeAiOauth",
    "requiredFields": ["accessToken", "refreshToken", "expiresAt"],
    "optionalFields": [
      "refreshTokenExpiresAt",
      "scopes",
      "subscriptionType",
      "subscriptionTypeSource",
      "subscriptionTypeVerifiedAt",
      "rateLimitTier",
      "clientId",
      "profile",
      "tokenAccount"
    ],
    "expiresAtUnit": "unix_ms"
  },
  "piMapping": {
    "type": "oauth",
    "access": "claudeAiOauth.accessToken",
    "refresh": "claudeAiOauth.refreshToken",
    "expires": "claudeAiOauth.expiresAt"
  }
}
