{
  "name": "@justjoshn/pi-anthropic-oauth",
  "version": "0.1.6",
  "description": "Use a Claude Pro or Max subscription in Pi. Requests identify as Provider CLI.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/just-joshn/pi-customizations.git",
    "directory": "extensions/pi-anthropic-oauth"
  },
  "homepage": "https://github.com/just-joshn/pi-customizations/tree/main/extensions/pi-anthropic-oauth#readme",
  "bugs": {
    "url": "https://github.com/just-joshn/pi-customizations/issues"
  },
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "docs/claude-oauth-parity.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p .",
    "prove:paths": "node --experimental-strip-types scripts/prove-request-paths.ts",
    "prove:context-guard": "node --experimental-strip-types scripts/prove-context-guard.ts --expect green",
    "prove:native": "node --experimental-strip-types scripts/prove-native.ts",
    "prove": "bun run prove:paths && bun run prove:context-guard && bun run prove:native",
    "live:exchange": "node --experimental-strip-types scripts/oauth-live-exchange.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
