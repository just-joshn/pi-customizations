{
  "name": "@justjoshn/pi-pstack-v2",
  "version": "0.3.0",
  "description": "Use the pstack skills and workflow in Pi, with the upstream subagent tool spawning Pi in tmux, shell jobs running in tmux, and Pi's tools running in a Gondolin micro-VM.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/just-joshn/pi-customizations.git",
    "directory": "extensions/pi-pstack-v2"
  },
  "keywords": [
    "pi-package",
    "pstack",
    "poteto-mode"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "skills",
    "docs",
    "README.md",
    "LICENSE",
    "!**/node_modules"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./src/subagent/index.ts",
      "./src/gondolin/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "vitest run --coverage && cd skills/poteto-mode/scripts && bun install --frozen-lockfile && bun test watch-pr",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "style-audit": "node ../../scripts/style-audit.mjs extensions/pi-pstack-v2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@vitest/coverage-v8": "5.1.0",
    "typebox": "1.3.27",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@earendil-works/gondolin": "0.14.0",
    "minimatch": "11.0.3",
    "zod": "^4"
  }
}
