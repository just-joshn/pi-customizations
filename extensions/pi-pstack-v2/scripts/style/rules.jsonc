{
  "$schema": "../../../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": "../.." },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "plugins": ["./immutability.grit", "./input-validation.grit"],
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "complexity": {
        "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 47 } },
        "noUselessCatch": "error"
      },
      "style": { "noMagicNumbers": "error" },
      "suspicious": {
        "noConsole": { "level": "error", "options": { "allow": ["assert", "debug", "dir", "error", "info", "table", "trace", "warn"] } },
        "noEmptyBlockStatements": "error",
        "useErrorMessage": "error"
      },
      "nursery": { "noFloatingPromises": "error", "noMisusedPromises": "error" }
    }
  }
}
