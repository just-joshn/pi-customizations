FROM node:22-bookworm-slim

# Every tool a job runs lives here. Pi, pstack, and credentials are mounted from the host, never baked in.
# There is no terminal multiplexer: the host owns the session and only runs the wrapper.
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ripgrep curl ca-certificates coreutils procps jq openssh-client python3 build-essential gnupg \
 && mkdir -p -m 755 /etc/apt/keyrings \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

# The job's own argv runs directly, not through the node image's entrypoint script.
ENTRYPOINT []
CMD ["bash"]
