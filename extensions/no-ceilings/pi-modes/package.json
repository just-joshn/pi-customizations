{
  "name": "@justjoshn/pi-modes",
  "version": "0.2.0",
  "description": "Four Pi-native execution modes (Agent, Ask, Plan, Debug) plus skill-backed custom modes, with read-only enforcement, structured plan artifacts, interactive clarifying questions, mode-switch proposals, and a local NDJSON debug ingest server.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/just-joshn/pi-customizations.git",
    "directory": "extensions/no-ceilings/pi-modes"
  },
  "keywords": [
    "pi-package",
    "no-ceilings",
    "modes",
    "plan-mode",
    "debug-mode",
    "custom-modes"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node test/e2e/verify-modes.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e:fake": "node test/e2e/verify-modes-fake.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "5.1.0",
    "typebox": "1.3.27",
    "typescript": "^7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "zod": "^4"
  }
}
