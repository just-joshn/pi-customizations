{
  "name": "@justjoshn/pi-subagents",
  "version": "0.1.2",
  "description": "Pi-native subagents extension with built-in and custom subagent discovery, foreground/background execution, resumption, read-only enforcement, live streaming TUI, background completion wakeups, and interactive tasks/transcript pager.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/just-joshn/pi-customizations.git",
    "directory": "extensions/no-ceilings/pi-subagents"
  },
  "keywords": [
    "pi-package",
    "no-ceilings",
    "subagents",
    "task-tool",
    "background-agents"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "5.1.0",
    "typebox": "1.3.27",
    "typescript": "^7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "zod": "^4"
  }
}
