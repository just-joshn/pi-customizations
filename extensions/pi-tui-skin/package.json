{
  "name": "pi-reference-cli",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Reference Agent CLI TUI parity for pi: themes, chrome, tool renderers, decisions, commands, pagers",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:coverage": "c8 --all --include='src/*.ts' --check-coverage --lines=80 --branches=80 --functions=80 --statements=80 node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.0",
    "c8": "12.0.0"
  },
  "pi": {
    "extensions": ["./src/index.ts"],
    "themes": ["./themes/*.json"],
    "prompts": ["./prompts/*.md"]
  }
}
