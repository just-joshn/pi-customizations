#!/usr/bin/env bash
# Starts the durable routines supervisor for one workspace.
set -euo pipefail
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
here="$(cd "$(dirname "$self")" && pwd)"
entry="$here/pstack-routines-supervisor.mjs"
if command -v bun >/dev/null 2>&1; then
  exec bun "$entry" "$@"
fi
exec node "$entry" "$@"
