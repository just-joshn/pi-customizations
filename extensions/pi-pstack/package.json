{
  "name": "pi-pstack",
  "version": "0.15.5-pi.2",
  "description": "pstack workflows for pi with preserved upstream sources and explicit host compatibility limits",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pstack"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills",
      "./host/skills"
    ],
    "prompts": [
      "./prompts",
      "./host/prompts"
    ]
  },
  "files": [
    "src",
    "skills",
    "prompts",
    "host",
    "upstream",
    "upstream/.gitignore",
    "upstream-team-kit",
    "docs",
    "scripts",
    "test",
    "tsconfig.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "generate": "node scripts/resources.mjs --write",
    "check:resources": "node scripts/resources.mjs",
    "check:cli": "node scripts/verify-cli.mjs",
    "check:journeys": "node scripts/verify-journeys.mjs",
    "check:upstream": "node scripts/verify-upstream.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@earendil-works/pi-tui": "0.99.2",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "typebox": "1.3.27",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
