{
  "name": "pi-pstack",
  "version": "0.15.5-pi.3",
  "description": "pstack workflows for pi with preserved upstream sources and explicit host compatibility limits",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/just-joshn/pi-customizations/tree/main/extensions/pi-pstack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/just-joshn/pi-customizations.git",
    "directory": "extensions/pi-pstack"
  },
  "keywords": [
    "pi-package",
    "pstack"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills",
      "./host/skills"
    ],
    "prompts": [
      "./prompts",
      "./host/prompts"
    ],
    "image": "https://raw.githubusercontent.com/just-joshn/pi-customizations/main/extensions/pi-pstack/upstream/assets/logo.png"
  },
  "files": [
    "src",
    "skills",
    "prompts",
    "host",
    "upstream",
    "upstream/.gitignore",
    "upstream-team-kit",
    "docs",
    "scripts",
    "test",
    "tsconfig.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "generate": "node scripts/resources.mjs --write",
    "check:resources": "node scripts/resources.mjs",
    "check:cli": "node scripts/verify-cli.mjs",
    "check:journeys": "node scripts/verify-journeys.mjs",
    "check:progress-tui": "node scripts/verify-progress-tui.mjs",
    "check:journeys:no-workers": "node scripts/verify-journeys.mjs . --no-workers",
    "check:native-parity": "node scripts/check-native-parity.mjs",
    "check:upstream": "node scripts/verify-upstream.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/helpers",
    "test": "vitest run && bun run test:helpers",
    "test:helpers": "bun test --preload ./test/helpers/leak-preload.ts test/helpers",
    "test:coverage": "vitest run --coverage",
    "check:parity": "node scripts/check-subagent-parity.mjs",
    "check:native-first": "node scripts/check-subagent-native-first.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "bun-types": "1.3.14",
    "commander": "14.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
