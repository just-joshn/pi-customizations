{
  "name": "pi-tui-parity",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "TUI parity layer for pi: themes, chrome, tool renderers, decisions, commands, pagers",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:docs": "node scripts/check-docs.mjs",
    "check:parity": "node scripts/check-parity.mjs",
    "check:smoke": "node scripts/tmux-smoke.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "typebox": "1.3.27",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "themes": [
      "./themes/*.json"
    ],
    "prompts": [
      "./prompts/*.md"
    ]
  }
}
