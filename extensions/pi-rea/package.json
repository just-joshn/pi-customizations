{
  "name": "@justjoshn/pi-rea",
  "version": "0.2.3",
  "description": "Deprecated and no longer maintained.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/just-joshn/pi-customizations.git",
    "directory": "extensions/pi-rea"
  },
  "homepage": "https://github.com/just-joshn/pi-customizations/tree/main/extensions/pi-rea#readme",
  "bugs": {
    "url": "https://github.com/just-joshn/pi-customizations/issues"
  },
  "keywords": [
    "pi-package",
    "reverse-engineering"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "files": [
    "src",
    "schemas",
    "skills",
    "prompts",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "generate:contracts": "bun scripts/generate-contracts.ts && bun scripts/generate-handler-types.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^22.19.0",
