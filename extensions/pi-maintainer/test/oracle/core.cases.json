  {
    "id": "chunks/provider-order",
    "op": "core.format_chunks",
    "args": {
      "main": "TEST MAIN",
      "reminder": "TEST REMINDER",
      "examples": [{ "role": "user", "content": "EXAMPLE USER" }, { "role": "assistant", "content": "EXAMPLE ASSISTANT" }],
      "readonly": [{ "role": "user", "content": "READ ONLY\nreference.txt\n```\nreference\n```\n" }, { "role": "assistant", "content": "Ok, I will use these files as references." }],
      "files": [{ "role": "user", "content": "EDITABLE\nedit.txt\n```\neditable\n```\n" }, { "role": "assistant", "content": "Ok, any changes I propose will be to those files." }],
      "current": [{ "role": "user", "content": "CURRENT" }]
    }
  },
