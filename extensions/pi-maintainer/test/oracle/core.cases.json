  { "id": "mentions/non-ascii-whitespace", "op": "core.file_mentions", "args": { "content": "a.py\u001cb.py\u0085c.py", "addable": ["a.py", "b.py", "c.py"] } },
  { "id": "mentions/embedded-not-a-word", "op": "core.file_mentions", "args": { "content": "(a.py) [b.py] prefixc.py", "addable": ["a.py", "b.py", "c.py"] } },
