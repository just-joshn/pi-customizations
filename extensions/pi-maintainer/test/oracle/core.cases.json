  { "id": "confirm/skip-shared", "op": "core.confirm", "args": { "group": ["a", "b"], "typed": ["skip"], "questions": [{ "question": "Allow?", "subject": "a" }, { "question": "Allow?", "subject": "b" }] } },
  { "id": "confirm/hidden-group", "op": "core.confirm", "args": { "group": ["a"], "preference": "all", "typed": ["no"], "questions": [{ "question": "Allow?", "subject": "a" }] } },
  {
    "id": "confirm/never-key",
    "op": "core.confirm",
    "args": { "typed": ["don't", "yes"], "questions": [{ "question": "Allow?", "subject": "a", "allow_never": true }, { "question": "Allow?", "subject": "a" }, { "question": "Allow?", "subject": "b" }] }
  },
  { "id": "confirm/never-before-global", "op": "core.confirm", "args": { "yes": true, "never": [["Allow?", null]], "questions": [{ "question": "Allow?" }] } },
  { "id": "confirm/explicit-all", "op": "core.confirm", "args": { "group": ["a", "b"], "preference": "all", "questions": [{ "question": "Run?", "explicit": true }] } },
