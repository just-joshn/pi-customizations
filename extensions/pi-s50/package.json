{
  "name": "pi-s50",
  "version": "0.1.0",
  "description": "S50: a deterministic engineering coordinator for Pi whose external skills are locked to the skills.sh all-time top 50.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "s50": "./dist/cli/main.js"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "src",
    "dist",
    "skills",
    "registry",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e 'require(\"node:fs\").chmodSync(\"dist/cli/main.js\", 0o755)'",
    "prepack": "bun run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p ."
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "typebox": "1.3.27",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
