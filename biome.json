{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/build",
      "!!**/coverage",
      "!!extensions/pi-pstack/upstream",
      "!!extensions/pi-caveman/vendor",
      "!!parity/reference",
      "!!parity/fixtures",
      "!!parity/evidence",
      "!!parity/private",
      "!!parity/artifacts",
      "!!parity/research",
      "!!parity/reviews",
      "!!parity/configurations.json",
      "!!parity/dependencies.json",
      "!!parity/inventory.json",
      "!!parity/mismatches.json",
      "!!parity/requirements.json",
      "!!parity/source-lock.json",
      "!!parity/scenarios",
      "!!extensions/pi-pstack/upstream-team-kit",
      "!!extensions/pi-pstack/skills",
      "!!extensions/pi-pstack/docs/resource-map.json",
      "!!extensions/pi-pstack/docs/parity/clauses",
      "!!extensions/pi-s50/test/fixtures/*.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 240
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "project": "recommended",
      "types": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredDependencies": "error"
      },
      "security": {
        "noSecrets": "warn"
      },
      "suspicious": {
        "noDeprecatedImports": "warn",
        "noImportCycles": "warn"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [[":BUN:", ":NODE:"], ":BLANK_LINE:"]
          }
        }
      }
    }
  }
}
