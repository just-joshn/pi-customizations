{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!extensions/pi-antigravity-oauth/src/pi-ai",
      "!extensions/pi-pstack/upstream",
      "!extensions/pi-pstack/upstream-team-kit",
      "!extensions/pi-pstack/skills",
      "!extensions/pi-pstack/docs",
      "!!**/dist",
      "!!**/build",
      "!!**/coverage",
      "!!**/upstream",
      "!!**/upstream-team-kit"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 240
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["**/personas.ts"],
      "javascript": {
        "formatter": {
          "quoteStyle": "single"
        }
      }
    },
    {
      "includes": ["**/models.ts"],
      "javascript": {
        "formatter": {
          "quoteStyle": "double"
        }
      }
    }
  ],
  "linter": {
    "enabled": true,
    "domains": {
      "project": "recommended",
      "types": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredDependencies": "error"
      },
      "security": {
        "noSecrets": "warn"
      },
      "suspicious": {
        "noDeprecatedImports": "warn",
        "noImportCycles": "warn"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [[":BUN:", ":NODE:"], ":BLANK_LINE:"]
          }
        }
      }
    }
  }
}
