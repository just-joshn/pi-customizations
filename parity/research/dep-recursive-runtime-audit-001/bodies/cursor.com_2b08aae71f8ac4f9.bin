\",\"td\",null,{\"className\":\"px-4 py-3 text-neutral-900 text-base dark:text-neutral-100 [\u0026:first-child_code]:whitespace-nowrap\",\"children\":[\"If \",[\"$\",\"code\",null,{\"className\":\"rounded-sm border border-border bg-card/80 p-1 font-mono text-xs\",\"children\":\"true\"}],\", the subagent runs with restricted write permissions (no file edits, no state-changing shell commands).\"]}]]}]\nbc:[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-neutral-900 text-base dark:text-neutral-100 [\u0026:first-child_code]:whitespace-nowrap\",\"children\":[\"$\",\"code\",null,{\"className\":\"rounded-sm border border-border bg-card/80 p-1 font-mono text-xs\",\"children\":\"is_background\"}]}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-neutral-900 text-base dark:text-neutral-100 [\u0026:first-child_code]:whitespace-nowrap\",\"children\":\"boolean\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-neutral-900 text-base dark:text-neutral-100 [\u0026:first-child_code]:whitespace-nowrap\",\"children\":\"No\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-neutral-900 text-base dark:text-neutral-100 [\u0026:first-child_code]:whitespace-nowrap\",\"children\":[\"$\",\"code\",null,{\"className\":\"rounded-sm border border-border bg-card/80 p-1 font-mono text-xs\",\"children\":\"false\"}]}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-neutral-900 text-base dark:text-neutral-100 [\u0026:first-child_code]:whitespace-nowrap\",\"children\":[\"If \",[\"$\",\"code\",null,{\"className\":\"rounded-sm border border-border bg-card/80 p-1 font-mono text-xs\",\"children\":\"true\"}],\", the subagent runs in the background without blocking the parent.\"]}]]}]\nc4:[\"$\",\"$Lc1\",\"How do I debug a misbehaving subagent?\",{\"value\":\"How do I debug a misbehaving subagent?\",\"children\":[[\"$\",\"$Lc2\",null,{\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2\",\"children\":[null,[\"$\",\"span\",null,{\"children\":\"How do I debug a misbehaving subagent?\"}]]}]}],[\"$\",\"$Lc3\",null,{\"children\":[\"$\",\"p\",null,{\"className\":\"text-base mb-4 leading-relaxed!\",\"ref\":\"$undefined\",\"children\":\"Check the subagent's description and prompt. Ensure the instructions are specific and unambiguous. You can also test the subagent by invoking it explicitly with a simple task.\"}]}]]}]\nc5:[\"$\",\"$Lc1\",\"Can a subagent use Other Models when the parent is on Auto?\",{\"value\":\""])</script><script>self.__next_f.push([1,"Can a subagent use Other Models when the parent is on Auto?\",\"children\":[[\"$\",\"$Lc2\",null,{\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2\",\"children\":[null,[\"$\",\"span\",null,{\"children\":\"Can a subagent use Other Models when the parent is on Auto?\"}]]}]}],[\"$\",\"$Lc3\",null,{\"children\":[\"$\",\"p\",null,{\"className\":\"text-base mb-4 leading-relaxed!\",\"ref\":\"$undefined\",\"children\":[\"Yes. Auto applies to the parent agent. Subagents can run a named third-party model, and that usage draws from the Other Models pool at that model's list price. The same happens when the parent is on Grok or Composer. See \",[\"$\",\"$L26\",null,{\"className\":\"text-foreground underline decoration-neutral-600 underline-offset-2 transition-colors hover:decoration-neutral-700\",\"href\":\"#parent-model-and-usage-pools\",\"children\":\"parent model and usage pools\"}],\".\"]}]}]]}]\n"])</script><script>self.__next_f.push([1,"c6:[\"$\",\"$Lc1\",\"Why is my subagent using a different model?\",{\"value\":\"Why is my subagent using a different model?\",\"children\":[[\"$\",\"$Lc2\",null,{\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2\",\"children\":[null,[\"$\",\"span\",null,{\"children\":\"Why is my subagent using a different model?\"}]]}]}],[\"$\",\"$Lc3\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-base mb-4 leading-relaxed!\",\"ref\":\"$undefined\",\"children\":[\"Subagents may run a different model from the parent picker. Built-in subagents pick a model for the subtask, and the parent can name a model when it launches a subagent. See \",[\"$\",\"$L26\",null,{\"className\":\"text-foreground underline decoration-neutral-600 underline-offset-2 transition-colors hover:decoration-neutral-700\",\"href\":\"#parent-model-and-usage-pools\",\"children\":\"parent model and usage pools\"}],\".\"]}],[\"$\",\"p\",null,{\"className\":\"text-base mb-4 leading-relaxed!\",\"ref\":\"$undefined\",\"children\":[\"Cursor also overrides a configured model when your team admin blocks it, your plan doesn't include it, or a legacy request-based plan requires \",[\"$\",\"$L26\",null,{\"className\":\"text-foreground underline decoration-neutral-600 underline-offset-2 transition-colors hover:decoration-neutral-700\",\"href\":\"/help/ai-features/max-mode\",\"children\":\"Max Mode\"}],\" and you don't have it enabled. On legacy request-based plans without Max Mode, subagents run using Composer regardless of any \",[\"$\",\"code\",null,{\"className\":\"rounded-sm border border-border bg-card/80 p-1 font-mono text-xs\",\"children\":\"model\"}],\" configuration. If your team admin has blocked Composer, subagents can run only when Max Mode is enabled. On usage-based plans and legacy request-based plans with Max Mode, subagents default to the parent model. See \",[\"$\",\"$L26\",null,{\"className\":\"text-foreground underline decoration-neutral-600 underline-offset-2 transition-colors hover:decoration-neutral-700\",\"href\":\"#model-configuration\",\"children\":\"model configuration\"}],\" for details.\"]}]]}]]}]\n"])</script></body></html>