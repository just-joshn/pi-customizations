d_code]:whitespace-nowrap\",\"children\":\"Long-running tasks or parallel workstreams.\"}]]}]]}]]}]}]}]\n"])</script><script>self.__next_f.push([1,"3d:[\"$\",\"$Lb3\",null,{\"className\":\"mt-12 mb-4\",\"children\":\"Built-in subagents\"}]\n3e:[\"$\",\"p\",null,{\"className\":\"text-base mb-4 leading-relaxed!\",\"ref\":\"$undefined\",\"children\":\"Cursor includes three built-in subagents that handle context-heavy operations automatically. These subagents were designed based on analysis of agent conversations where context window limits were hit.\"}]\n"])</script><script>self.__next_f.push([1,"3f:[\"$\",\"div\",null,{\"className\":\"full-width-table\",\"children\":[\"$\",\"div\",null,{\"className\":\"my-6 overflow-x-auto rounded-sm border dark:border-muted\",\"children\":[\"$\",\"table\",null,{\"className\":\"min-w-full divide-y divide-neutral-200 bg-card dark:divide-muted dark:bg-card\",\"children\":[[\"$\",\"thead\",null,{\"className\":\"dark:text-neutral-300\",\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",null,{\"className\":\"whitespace-nowrap px-4 py-3 text-left font-medium text-xs\",\"scope\":\"col\",\"children\":\"Subagent\"}],[\"$\",\"th\",null,{\"className\":\"whitespace-nowrap px-4 py-3 text-left font-medium text-xs\",\"scope\":\"col\",\"children\":\"Purpose\"}],[\"$\",\"th\",null,{\"className\":\"whitespace-nowrap px-4 py-3 text-left font-medium text-xs\",\"scope\":\"col\",\"children\":\"Why it's a subagent\"}]]}]}],[\"$\",\"tbody\",null,{\"className\":\"divide-y divide-neutral-200 bg-background dark:divide-muted\",\"children\":[[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-neutral-900 text-base dark:text-neutral-100 [\u0026:first-child_code]:whitespace-nowrap\",\"children\":[\"$\",\"strong\",null,{\"children\":\"Explore\"}]}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-neutral-900 text-base dark:text-neutral-100 [\u0026:first-child_code]:whitespace-nowrap\",\"children\":\"Searches and analyzes codebases\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-neutral-900 text-base dark:text-neutral-100 [\u0026:first-child_code]:whitespace-nowrap\",\"children\":\"Codebase exploration generates large intermediate output that would bloat the main context. Uses a faster model to run many parallel searches.\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-neutral-900 text-base dark:text-neutral-100 [\u0026:first-child_code]:whitespace-nowrap\",\"children\":[\"$\",\"strong\",null,{\"children\":\"Bash\"}]}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-neutral-900 text-base dark:text-neutral-100 [\u0026:first-child_code]:whitespace-nowrap\",\"children\":\"Runs series of shell commands\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-neutral-900 text-base dark:text-neutral-100 [\u0026:first-child_code]:whitespace-nowrap\",\"children\":\"Command output is often verbose. Isolating it keeps the parent focused on decisions, not logs.\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-neutral-900 text-base dark:text-neutral-100 [\u0026:first-child_code]:whitespace-nowrap\",\"children\":[\"$\",\"strong\",null,{\"children\":\"Browser\"}]}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-neutral-900 text-base dark:text-neutral-100 [\u0026:first-child_code]:whitespace-nowrap\",\"children\":\"Controls browser via MCP tools\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-neutral-900 text-base dark:text-neutral-100 [\u0026:first-child_code]:whitespace-nowrap\",\"children\":\"Browser interactions produce noisy DOM snapshots and screenshots. The subagent filters this down to relevant results.\"}]]}]]}]]}]}]}]\n"])</script><script>self.__next_f.push([1,"40:[\"$\",\"$Lb4\",null,{\"className\":\"mb-3\",\"children\":\"Why these subagents exist\"}]\n41:[\"$\",\"p\",null,{\"className\":\"text-base mb-4 leading-relaxed!\",\"ref\":\"$undefined\",\"children\":\"These three operations share common traits: they generate noisy intermediate output, benefit from specialized prompts and tools, and can consume significant context. Running them as subagents solves several problems:\"}]\n42:[\"$\",\"ul\",null,{\"className\":\"my-6 prose-ul-markers\",\"style\":{\"listStyleType\":\"square\",\"listStylePosition\":\"outside\",\"paddingLeft\":\"calc(4rem / 3)\",\"lineHeight\":\"1.5\"},\"children\":[\"\\n\",[\"$\",\"li\",null,{\"style\":{\"paddingInlineStart\":\"4px\",\"margin\":\"0 0 0.5rem 0\",\"fontSize\":\"15px\"},\"children\":[[\"$\",\"strong\",null,{\"children\":\"Context isolation\"}],\" — Intermediate output stays in the subagent. The parent only sees the final summary.\"]}],\"\\n\",[\"$\",\"li\",null,{\"style\":{\"paddingInlineStart\":\"4px\",\"margin\":\"0 0 0.5rem 0\",\"fontSize\":\"15px\"},\"children\":[[\"$\",\"strong\",null,{\"children\":\"Model flexibility\"}],\" — The explore subagent uses a faster model by default. This enables running 10 parallel searches in the time a single main-agent search would take.\"]}],\"\\n\",[\"$\",\"li\",null,{\"style\":{\"paddingInlineStart\":\"4px\",\"margin\":\"0 0 0.5rem 0\",\"fontSize\":\"15px\"},\"children\":[[\"$\",\"strong\",null,{\"children\":\"Specialized configuration\"}],\" — Each subagent has prompts and tool access tuned for its specific task.\"]}],\"\\n\",[\"$\",\"li\",null,{\"style\":{\"paddingInlineStart\":\"4px\",\"margin\":\"0 0 0.5rem 0\",\"fontSize\":\"15px\"},\"children\":[[\"$\",\"strong\",null,{\"children\":\"Cost efficiency\"}],\" — Faster models cost less. Isolating token-heavy work in subagents with appropriate model choices reduces overall cost.\"]}],\"\\n\"]}]\n43:[\"$\",\"p\",null,{\"className\":\"text-base mb-4 leading-relaxed!\",\"ref\":\"$undefined\",\"children\":\"You don't need to configure these subagents. Agent uses them automatically when appropriate.\"}]\n44:[\"$\",\"$Lb3\",null,{\"className\":\"mt-12 mb-4\",\"children\":\"When to use subagents\"}]\n"])</script><script>self.__