 [ -s "$prs" ] || echo "[]" > "$prs"
 
-# Transcripts dir: ~/.cursor/projects/<slugified-repo-path>/agent-transcripts.
-slug=$(printf '%s' "$main_wt" | sed 's#^/##; s#/#-#g')
-transcripts="$HOME/.cursor/projects/$slug/agent-transcripts"
+# Transcripts: Pi session files and pi-pstack subagent transcripts. Pi keeps one session folder per working
+# directory under ${PI_CODING_AGENT_DIR:-~/.pi/agent}/sessions, unless PI_CODING_AGENT_SESSION_DIR or a sessionDir
+# setting (the working directory's .pi/settings.json over the agent's settings.json) names one custom folder, with
+# ~ expanded (also in PI_CODING_AGENT_DIR) and a relative path resolved from that working directory. Subagent transcripts live under
+# <agent dir>/pstack/workspaces/<folder>/subagents.
+pi_expand() { case "$1" in "~") printf '%s' "$HOME" ;; "~/"*) printf '%s' "$HOME/${1#"~/"}" ;; *) printf '%s' "$1" ;; esac; }
+pi_agent_dir=$(pi_expand "${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}")
+pi_slug() { printf -- '--%s--' "$(printf '%s' "$1" | sed 's#^/##; s#[/\\:]#-#g')"; }
+pi_session_dir() {
+	local dir="${PI_CODING_AGENT_SESSION_DIR:-}"
+	[ -n "$dir" ] || dir=$(jq -r '.sessionDir // empty' "$1/.pi/settings.json" 2>/dev/null)
+	[ -n "$dir" ] || dir=$(jq -r '.sessionDir // empty' "$pi_agent_dir/settings.json" 2>/dev/null)
+	dir=$(pi_expand "$dir")
+	case "$dir" in
+	"") printf '%s\n' "$pi_agent_dir/sessions/$(pi_slug "$1")" ;;
+	/*) printf '%s\n' "$dir" ;;
+	*) printf '%s\n' "$1/$dir" ;;
+	esac
+}
+pi_chat_dirs() {
+	pi_session_dir "$1"
+	printf '%s\n' "$pi_agent_dir/pstack/workspaces/$(pi_slug "$1")/subagents"
+}
