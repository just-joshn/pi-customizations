ci_workflow:
name: pi-pstack

on:
  pull_request:
    paths:
      - 'extensions/pi-pstack/**'
      - '.github/workflows/pi-pstack.yml'
  push:
    branches:
      - main
    paths:
      - 'extensions/pi-pstack/**'

permissions:
  contents: read

jobs:
  verify:
    runs-on: ubuntu-24.04
    # Both jobs take 6 to 9 minutes. With this limit, a hung test fails its job and leaves a log. Without it, the job
    # waits out GitHub's 6-hour default and shows no log until someone cancels the run.
    timeout-minutes: 30
    defaults:
      run:
        working-directory: extensions/pi-pstack
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: 26.13.0
      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6
        with:
          bun-version: 1.4.2
      # The readonly shell's OS sandbox on Linux, per @anthropic-ai/sandbox-runtime's Linux requirements
      # and its own GitHub Actions integration workflow.
      - run: |
          sudo apt-get update
          sudo apt-get install -y bubblewrap socat ripgrep
          sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
          sudo chmod u+s "$(which bwrap)"
          bwrap --ro-bind / / --unshare-net true
      - run: bun install --frozen-lockfile
        working-directory: .
      - run: bun run typecheck
      - run: bun run test
      - uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3
        with:
          distribution: temurin
          java-version: '25.0.5+8'
      - run: |
          curl --fail --location --retry 3 https://github.com/tlaplus/tlaplus/releases/download/v1.7.4/tla2tools.jar -o "$RUNNER_TEMP/tla2tools.jar"
          echo '936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88' " $RUNNER_TEMP/tla2tools.jar" | sha256sum --check
          echo "TLA2TOOLS=$RUNNER_TEMP/tla2tools.jar" >> "$GITHUB_ENV"
          echo "JAVA=$JAVA_HOME/bin/java" >> "$GITHUB_ENV"
      - run: bun run test:statechart

  # The release workflow runs on macOS and publishes from it, so the same suite runs here on every pull request.
  # A /var to /private/var temp-root difference and a /proc-only lock takeover both escaped the Ubuntu leg and failed
  # the release instead.
  #
  # Hosted macOS ARM capacity can cancel this job before any step runs ("not acquired by Runner").
  # retry-pi-pstack-macos-capacity.yml re-runs failed jobs once when that happens and Ubuntu already passed.
  verify-macos:
    runs-on: macos-15
    timeout-minutes: 30
    defaults:
      run:
        working-directory: extensions/pi-pstack
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: 26.13.0
      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6
        with:
          bun-version: 1.4.2
      - run: brew install ripgrep
      - run: bun install --frozen-lockfile
        working-directory: .
      - run: bun run typecheck
      - run: bun run test
      - uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3
        with:
          distribution: temurin
          # The macOS index publishes this build as 25.0.5+8.0.LTS, not 25.0.5+8.
          java-version: '25.0.5+8.0.LTS'
      - run: |
          curl --fail --location --retry 3 https://github.com/tlaplus/tlaplus/releases/download/v1.7.4/tla2tools.jar -o "$RUNNER_TEMP/tla2tools.jar"
          echo '936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88' " $RUNNER_TEMP/tla2tools.jar" | shasum -a 256 --check
          echo "TLA2TOOLS=$RUNNER_TEMP/tla2tools.jar" >> "$GITHUB_ENV"
          echo "JAVA=$JAVA_HOME/bin/java" >> "$GITHUB_ENV"
      - run: bun run test:statechart

