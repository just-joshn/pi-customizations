import { readFileSync, writeFileSync } from 'node:fs';
const EXT = '/Users/josh-desktop/src/personal/pi-x-subscription-oauth-audit/extensions/pi-x-subscription-oauth/src/cursor';
const { cursorCatalogHeaders, usableModelsUrl, parseUsableModels } = await import(`${EXT}/catalog.ts`);
const token = JSON.parse(readFileSync('/tmp/xaudit/piagent/auth.json', 'utf8')).cursor.access;
const r = await fetch(usableModelsUrl('https://api2.cursor.sh'), { method: 'POST', headers: cursorCatalogHeaders(token), body: '{}' });
const body = await r.json();
writeFileSync('/tmp/xaudit/cursor-usable-raw.json', JSON.stringify(body, null, 1));
console.log(r.status, Object.keys(body), body.models?.length, JSON.stringify(body.models?.slice(0, 2)));
const parsed = parseUsableModels(body);
console.log(parsed.kind, parsed.models?.length);
