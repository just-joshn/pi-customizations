{
  "name": "pi-customizations",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "extensions/*"
  ],
  "description": "Standalone Pi skills: doctor, run, simplify, reverse-engineer-cli, and implement-cli-from-contract.",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "bun run --sequential --filter '*' test",
    "check:agents": "node scripts/check-agents-compliance.selftest.mjs && node scripts/check-agents-compliance.mjs",
    "check:tests": "node extensions/scripts/check-vitest-conventions.selftest.mjs && node extensions/scripts/check-vitest-conventions.mjs",
    "check:toolchain": "node scripts/check-bun-toolchain.selftest.mjs && node scripts/check-bun-toolchain.mjs",
    "test:coverage": "bun run --sequential --filter pi-pstack --filter pi-one-dark-pro-theme test:coverage",
    "sync:types-policy": "node scripts/sync-typescript-policy.mjs --write",
    "check:types-policy": "node scripts/typescript-policy.selftest.mjs && node scripts/sync-typescript-policy.mjs && node scripts/check-typescript-policy.selftest.mjs && node scripts/check-typescript-policy.mjs",
    "typecheck": "bun run check:types-policy && tsc --noEmit -p tsconfig.json && bun run --sequential --filter '*' typecheck",
    "check": "biome check .",
    "check:write": "node scripts/format-write.selftest.mjs && node scripts/format-write.mjs",
    "ci": "biome ci . --error-on-warnings --max-diagnostics=none"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2",
    "@biomejs/biome": "2.5.14"
  }
}
