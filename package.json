{
  "name": "pi-customizations",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["extensions/*"],
  "description": "Standalone Pi skills: doctor, run, simplify, reverse-engineer-cli, and implement-cli-from-contract.",
  "license": "MIT",
  "keywords": ["pi-package"],
  "pi": {
    "skills": ["./skills"]
  },
  "scripts": {
    "test": "bun run --sequential --filter '*' test",
    "check:tests": "node extensions/scripts/check-vitest-conventions.selftest.mjs && node extensions/scripts/check-vitest-conventions.mjs",
    "test:coverage": "bun run --sequential --filter pi-pstack --filter pi-tui-parity --filter pi-one-dark-pro-theme test:coverage",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "ci": "biome ci . --error-on-warnings --max-diagnostics=none"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2",
    "@biomejs/biome": "2.5.14"
  }
}
