{
  "name": "pi-customizations",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "private": true,
  "workspaces": [
    "extensions/*"
  ],
  "description": "Workspace root for the pi-customizations Pi extensions.",
  "license": "MIT",
  "scripts": {
    "test": "bun run --sequential --filter \"*\" test",
    "typecheck": "bun run --sequential --filter \"*\" typecheck",
    "check": "biome check . --error-on-warnings",
    "ci": "biome ci . --error-on-warnings --max-diagnostics=none && bun scripts/style-audit.mjs && node scripts/behavior-test-audit.mjs",
    "style-audit": "node scripts/style-audit.mjs",
    "behavior-test-audit": "node scripts/behavior-test-audit.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2",
    "@biomejs/biome": "2.5.14",
    "zod": "^4"
  }
}
