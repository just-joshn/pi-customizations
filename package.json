{
  "name": "pi-customizations",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "private": true,
  "workspaces": [
    "extensions/*"
  ],
  "description": "Workspace root for the pi-customizations Pi extensions.",
  "license": "MIT",
  "scripts": {
    "test": "bun run --sequential --filter \"*\" test",
    "typecheck": "bun run --sequential --filter \"*\" typecheck",
    "check": "biome check .",
    "ci": "biome ci . --error-on-warnings --max-diagnostics=none"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2",
    "@biomejs/biome": "2.5.14"
  }
}
