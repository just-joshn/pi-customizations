#!/usr/bin/env node
// Drives the pi-pstack extension through the installed `pi` CLI (JSON and RPC modes) the way a user
// does: the package loads from settings.json `packages` (what `pi install` writes), and the only fake is
// the model, the package's own deterministic `scripted/echo` provider (test/fixtures/scripted-model.ts),
// which turns a `@@script [...]` directive in the prompt into real tool calls. Every Pi process gets a
// disposable HOME, agent dir, and working directory, so no run touches ~/.pi/agent or a real model.
import assert from 'node:assert/strict';
import { execFileSync, spawn } from 'node:child_process';
import { cpSync, existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, realpathSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { basename, dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const HERE = dirname(fileURLToPath(import.meta.url));
const REPO_ROOT = resolve(HERE, '../../../..');
const PACKAGE = join(REPO_ROOT, 'extensions/pi-pstack');
const SCRIPTED_MODEL = join(PACKAGE, 'test/fixtures/scripted-model.ts');
const EVIDENCE_ROOT = join(REPO_ROOT, 'artifacts/verify-pi-pstack');
const SCRATCH_PREFIX = 'verify-pi-pstack-';
const FEATURES = ['task-subagents', 'background-shell', 'plan-mode', 'todos'];
const TIMEOUT_MS = 60_000;
// Variables that would point a child at the user's real session, or give it a subagent identity.
const SCRUB = /^(PI_CODING_AGENT|PI_SESSION|PI_PSTACK_|PI_MODEL$|PI_PROVIDER$|PI_REASONING_LEVEL$|PI_OFFLINE$|PSTACK_)/;

const log = (line) => process.stdout.write(`${line}\n`);
const sleep = (ms) => new Promise((done) => setTimeout(done, ms));
const script = (steps) => `run the script\n@@script ${JSON.stringify(steps)}`;
const textOf = (content) => (typeof content === 'string' ? content : (content ?? []).map((part) => part.text ?? '').join(''));
const slug = (cwd) => `--${cwd.replace(/^\//, '').replace(/[/\\:]/g, '-')}--`;

// ---------- scratch run ----------

function createRun(feature) {
  const root = realpathSync(mkdtempSync(join(tmpdir(), SCRATCH_PREFIX)));
  const run = { root, feature, agentDir: join(root, 'agent'), work: join(root, 'work'), home: join(root, 'home'), pids: [] };
  for (const dir of [run.agentDir, run.work, run.home]) mkdirSync(dir);
  writeFileSync(join(run.agentDir, 'settings.json'), JSON.stringify({ packages: [PACKAGE], extensions: [SCRIPTED_MODEL], quietStartup: true }, null, 2));
  saveRun(run);
  return run;
}

const saveRun = (run) => writeFileSync(join(run.root, 'run.json'), JSON.stringify(run, null, 2));

function childEnv(run) {
  const env = Object.fromEntries(Object.entries(process.env).filter(([name]) => !SCRUB.test(name)));
  // PSTACK_CLOUD_DRIVER=worktree keeps any cloud path off a container engine.
  return { ...env, HOME: run.home, PI_CODING_AGENT_DIR: run.agentDir, PI_OFFLINE: '1', PI_SKIP_VERSION_CHECK: '1', PSTACK_CLOUD_DRIVER: 'worktree' };
}

const workspaceDir = (run) => join(run.agentDir, 'pstack/workspaces', slug(run.work));

/** PIDs this run started: the Pi processes plus any subagent recorded under the scratch workspace. */
function ownedPids(run) {
  const pids = [...(run.pids ?? [])];
  const records = join(run.agentDir, 'pstack/workspaces', slug(run.work), 'subagents');
  if (existsSync(records))
    for (const name of readdirSync(records).filter((file) => file.endsWith('.json'))) {
      try {
        const pid = JSON.parse(readFileSync(join(records, name), 'utf8')).pid;
        if (Number.isInteger(pid)) pids.push(pid);
      } catch {
        // A record mid-write; its process is in a group we kill anyway.
      }
    }
  return pids;
}

function killRun(run) {
  for (const pid of ownedPids(run))
    for (const target of [-pid, pid])
      try {
        process.kill(target, 'SIGKILL');
      } catch {
        // Already gone, or not a group leader.
      }
}

function destroyRun(run, keep) {
  killRun(run);
  if (!keep) rmSync(run.root, { recursive: true, force: true, maxRetries: 5, retryDelay: 200 });
}

// ---------- Pi processes ----------

function spawnPi(run, args) {
  // detached: Pi leads its own process group, so cleanup can kill it and every job it spawned in that group.
  const child = spawn('pi', ['--offline', '--model', 'scripted/echo', ...args], { cwd: run.work, env: childEnv(run), stdio: ['pipe', 'pipe', 'pipe'], detached: true });
  run.pids.push(child.pid);
  saveRun(run);
  return child;
}

function onLines(stream, handle) {
  let buffer = '';
  stream.on('data', (chunk) => {
    buffer += chunk.toString('utf8');
    for (let index = buffer.indexOf('\n'); index !== -1; index = buffer.indexOf('\n')) {
      const line = buffer.slice(0, index).trim();
      buffer = buffer.slice(index + 1);
      if (line !== '') handle(line);
    }
  });
}

/** `pi --mode json --no-session <prompt>`: one turn plus whatever background work it waits for. */
function runJson(run, prompt) {
  return new Promise((done, fail) => {
    const child = spawnPi(run, ['--mode', 'json', '--no-session', prompt]);
    child.stdin.end();
    const events = [];
    let stderr = '';
    onLines(child.stdout, (line) => events.push(JSON.parse(line)));
    child.stderr.on('data', (chunk) => {
      stderr += chunk.toString('utf8');
    });
    const timer = setTimeout(() => {
      child.kill('SIGKILL');
      fail(new Error(`pi --mode json timed out after ${TIMEOUT_MS}ms\n${stderr.slice(-2000)}`));
    }, TIMEOUT_MS);
    child.on('close', (exitCode) => {
      clearTimeout(timer);
      done({ events, exitCode, stderr });
    });
  });
}

/** `pi --mode rpc` with a session dir inside the scratch run. `answers` replies to select/confirm dialogs in order. */
function startRpc(run, answers = []) {
  const child = spawnPi(run, ['--mode', 'rpc', '--session-dir', join(run.root, 'sessions')]);
  const events = [];
  const dialogs = [];
  const waiters = [];
  let stderr = '';
  const send = (command) => child.stdin.write(`${JSON.stringify(command)}\n`);
  onLines(child.stdout, (line) => {
    const event = JSON.parse(line);
    events.push(event);
    if (event.type === 'extension_ui_request' && (event.method === 'select' || event.method === 'confirm')) {
      dialogs.push(event);
      const answer = answers.shift();
      send({ type: 'extension_ui_response', id: event.id, ...(answer === undefined ? { cancelled: true } : typeof answer === 'boolean' ? { confirmed: answer } : { value: answer }) });
    }
    for (const waiter of waiters.filter((candidate) => candidate.predicate(event))) {
      waiters.splice(waiters.indexOf(waiter), 1);
      waiter.done(event);
    }
  });
  child.stderr.on('data', (chunk) => {
    stderr += chunk.toString('utf8');
  });
  const waitFor = (predicate, label) =>
    new Promise((done, fail) => {
      const seen = events.find(predicate);
      if (seen !== undefined) return done(seen);
      const timer = setTimeout(() => fail(new Error(`timed out waiting for ${label}\n${stderr.slice(-2000)}`)), TIMEOUT_MS);
      waiters.push({ predicate, done: (event) => (clearTimeout(timer), done(event)) });
    });
  /** Sends a prompt (or a slash command) and returns its events, up to agent_settled unless a command handled it. */
  const prompt = async (message) => {
    const mark = events.length;
    const id = `p-${mark}`;
    send({ id, type: 'prompt', message });
    const response = await waitFor((event) => event.type === 'response' && event.id === id, `the response to ${message.slice(0, 40)}`);
    if (response.success === false) throw new Error(`prompt rejected: ${JSON.stringify(response)}`);
    if (response.data?.disposition !== 'handled') await waitFor((event) => event.type === 'agent_settled' && events.indexOf(event) >= mark, 'agent_settled');
    return events.slice(mark);
  };
  const close = () =>
    new Promise((done) => {
      if (child.exitCode !== null) return done();
      const force = setTimeout(() => child.kill('SIGKILL'), 5_000);
      child.once('close', () => (clearTimeout(force), done()));
      child.stdin.end();
    });
  return { events, dialogs, send, waitFor, prompt, close, stderr: () => stderr };
}

const toolEnds = (events, toolName) =>
  events.filter((event) => event.type === 'tool_execution_end' && event.toolName === toolName).map((event) => ({ isError: event.isError === true, text: textOf(event.result?.content), details: event.result?.details, toolCallId: event.toolCallId }));
const assistantTexts = (events) => events.filter((event) => event.type === 'message_end' && event.message?.role === 'assistant').map((event) => textOf(event.message.content));
const customMessages = (events, customType) =>
  events
    .filter((event) => event.type === 'entry_appended' && event.entry?.type === 'custom_message' && event.entry.customType === customType)
    .map((event) => textOf(event.entry.content));
const uiRequests = (events, method, key) => events.filter((event) => event.type === 'extension_ui_request' && event.method === method && (key === undefined || event.statusKey === key || event.widgetKey === key));

const writeJsonl = (path, events) => writeFileSync(path, `${events.map((event) => JSON.stringify(event)).join('\n')}\n`);
const writeJson = (path, value) => writeFileSync(path, `${JSON.stringify(value, null, 2)}\n`);

// ---------- drives ----------

const AGENT_ID = /Agent ID: ([0-9a-f-]{36})/;

async function driveTaskSubagents(run, out) {
  const fg = await runJson(run, script([{ tool: 'Task', args: { description: 'probe', prompt: 'go\n@@say PONG-FG', run_in_background: false } }]));
  writeJsonl(join(out, 'foreground.events.jsonl'), fg.events);
  const [fgResult] = toolEnds(fg.events, 'Task');
  assert.ok(fgResult, `foreground Task never ran\n${fg.stderr.slice(-1000)}`);
  assert.equal(fgResult.isError, false, fgResult.text);
  assert.match(fgResult.text, /^This is the output of the subagent:\n\nresponse:\n<response>\nPONG-FG\n<\/response>\n\nAgent ID: [0-9a-f-]{36} \(can be used with the `resume` parameter/);
  const fgId = AGENT_ID.exec(fgResult.text)[1];
  const subagents = join(workspaceDir(run), 'subagents');
  const transcript = readdirSync(subagents).find((name) => name.endsWith(`_${fgId}.jsonl`));
  assert.ok(transcript, `no transcript for ${fgId} in ${subagents}`);
  const childTexts = readFileSync(join(subagents, transcript), 'utf8')
    .trim()
    .split('\n')
    .map((line) => JSON.parse(line))
    .filter((entry) => entry.message?.role === 'assistant')
    .map((entry) => textOf(entry.message.content));
  assert.deepEqual(childTexts, ['PONG-FG'], 'the child transcript holds the child reply');
  assert.ok(existsSync(join(subagents, `${fgId}.json`)), 'the subagent record exists');

  const bg = await runJson(run, script([{ tool: 'Task', args: { description: 'probe', prompt: 'go\n@@sleep 1500 PONG-BG', run_in_background: true } }]));
  writeJsonl(join(out, 'background.events.jsonl'), bg.events);
  const [launch] = toolEnds(bg.events, 'Task');
  assert.ok(launch?.text.startsWith('Subagent is running in the background. If needed, you can monitor its output by tailing the transcript at: '), launch?.text);
  const bgId = AGENT_ID.exec(launch.text)?.[1];
  const [notice] = customMessages(bg.events, 'pstack/task');
  assert.ok(notice, 'a pstack/task completion notice was appended');
  assert.match(notice, new RegExp(`<task>\\nkind: subagent\\nstatus: success\\ntask_id: ${bgId}\\ntitle: go\\ntool_call_id: ${launch.toolCallId}\\ndetail: PONG-BG\\n</task>`));
  assert.ok(assistantTexts(bg.events).at(-1)?.startsWith('ECHO: <system_notification>'), 'the run took a turn on the notice');
  assert.equal(bg.exitCode, 0);

  const status = await runJson(run, script([{ tool: 'agent_status', args: {} }]));
  writeJsonl(join(out, 'status.events.jsonl'), status.events);
  const [statusResult] = toolEnds(status.events, 'agent_status');
  assert.ok(statusResult?.text.startsWith('2 subagents in this workspace:'), statusResult?.text);
  for (const id of [fgId, bgId]) assert.ok(statusResult.text.includes(id), `agent_status lists ${id}`);

  cpSync(subagents, join(out, 'subagents'), { recursive: true });
  writeJson(join(out, 'results.json'), { foreground: fgResult.text, backgroundLaunch: launch.text, backgroundNotice: notice, agentStatus: statusResult.text });
  return `foreground ${fgId} replied PONG-FG; background ${bgId} notified success; agent_status lists both`;
}

async function driveBackgroundShell(run, out) {
  const bg = await runJson(run, script([{ tool: 'bash_background', args: { command: 'sleep 1; echo BG-DONE', description: 'bg probe' } }]));
  writeJsonl(join(out, 'background.events.jsonl'), bg.events);
  const [launch] = toolEnds(bg.events, 'bash_background');
  assert.match(launch?.text ?? '', /^Background command started successfully\.\nShell ID: \d+\nPID: \d+\nCommand: sleep 1; echo BG-DONE\nOutput will be written to \S+\/terminals\/\d+\.txt\. Don't mention Shell ID to the user\.$/);
  const shellId = /^Shell ID: (\d+)$/m.exec(launch.text)[1];
  const outputFile = /Output will be written to (\S+)\./.exec(launch.text)[1];
  assert.ok(outputFile.startsWith(join(workspaceDir(run), 'terminals')), `terminal file under the scratch workspace: ${outputFile}`);
  const [notice] = customMessages(bg.events, 'pstack/shell');
  assert.ok(notice, 'a pstack/shell completion notice was appended');
  assert.match(notice, new RegExp(`<task>\\nkind: shell\\nstatus: success\\ntask_id: ${shellId}\\ntitle: bg probe\\ntool_call_id: ${launch.toolCallId}\\n</task>`));
  assert.ok(assistantTexts(bg.events).at(-1)?.startsWith('ECHO: <system_notification>'), 'the run took a turn on the notice');
  const terminal = readFileSync(outputFile, 'utf8');
  assert.match(terminal, /status: succeeded\n[\s\S]*---\nBG-DONE\n\n---\nexit_code: 0\n/);
  writeFileSync(join(out, `terminal-${shellId}.txt`), terminal);

  const fg = await runJson(run, script([{ tool: 'bash_background', args: { command: 'echo FG-OK; echo ERR-LINE 1>&2; exit 7', block_until_ms: 20_000 } }]));
  writeJsonl(join(out, 'foreground.events.jsonl'), fg.events);
  const [done] = toolEnds(fg.events, 'bash_background');
  assert.match(done?.text ?? '', /^Exit code: 7\n\nCommand output:\n\n```\nFG-OK\nERR-LINE\n\n```\n\nCommand completed in \d+ ms\.$/);
  assert.deepEqual(customMessages(fg.events, 'pstack/shell'), [], 'a command finished inside block_until_ms sends no notice');

  writeJson(join(out, 'results.json'), { launch: launch.text, notice, terminalFile: outputFile, blocking: done.text });
  return `background job ${shellId} wrote BG-DONE with exit_code 0 and notified; blocking call returned exit 7 with no notice`;
}

async function drivePlanMode(run, out) {
  writeFileSync(join(run.work, 'code.ts'), 'export {};\n');
  const rpc = startRpc(run, ['No, propose changes']);
  try {
    const on = await rpc.prompt('/plan');
    const onNotice = uiRequests(on, 'notify').map((event) => event.message);
    assert.ok(onNotice.some((message) => message.startsWith('Plan mode on: read-only tools only. /plan off exits.')), JSON.stringify(onNotice));
    assert.equal(uiRequests(rpc.events, 'setStatus', 'pstack-plan').at(-1)?.statusText !== undefined, true, 'the footer shows plan');

    const steps = [
      { tool: 'CreatePlan', args: { name: 'Ship it', overview: 'Prove the file.', plan: '# Ship it\n\n- prove the file exists', todos: [{ id: 'prove', content: 'Prove the file exists' }] } },
      { tool: 'write', args: { path: 'notes.md', content: '# notes\n' } },
      { tool: 'edit', args: { path: 'code.ts', edits: [{ oldText: 'export {};', newText: 'export const x = 1;' }] } },
    ];
    const turn = await rpc.prompt(script(steps));
    const ends = turn.filter((event) => event.type === 'tool_execution_end');
    assert.deepEqual(
      ends.map((event) => [event.toolName, event.isError]),
      [
        ['CreatePlan', false],
        ['write', false],
        ['edit', true],
      ],
    );
    const planFile = String(ends[0].result?.details?.planFile ?? '');
    assert.match(planFile, /\/pstack\/plans\/Ship it-[0-9a-f]{8}\.plan\.md$/);
    const plan = readFileSync(planFile, 'utf8');
    assert.match(plan, /^<!-- [0-9a-f-]+ -->\n---\ntodos:\n {2}- id: "prove"\n {4}content: "Prove the file exists"\n {4}status: pending\nisProject: false\n---\n# Ship it\n\n- prove the file exists$/);
    assert.equal(existsSync(join(run.work, 'notes.md')), true, 'markdown writes are allowed');
    assert.equal(readFileSync(join(run.work, 'code.ts'), 'utf8'), 'export {};\n', 'code edits are blocked');
    await rpc.waitFor(() => rpc.dialogs.length >= 1, 'the build dialog');
    assert.deepEqual(rpc.dialogs[0].options, ['Yes, build locally', 'No, propose changes']);

    const off = await rpc.prompt('/plan off');
    const offNotice = uiRequests(off, 'notify').map((event) => event.message);
    assert.ok(offNotice.includes('Plan mode off: tools restored.'), JSON.stringify(offNotice));
    assert.equal(uiRequests(rpc.events, 'setStatus', 'pstack-plan').at(-1)?.statusText, undefined, 'the footer plan status is cleared');

    writeFileSync(join(out, basename(planFile)), plan);
    writeJson(join(out, 'results.json'), { onNotice, tools: ends.map((event) => ({ tool: event.toolName, isError: event.isError, text: textOf(event.result?.content) })), planFile, dialog: rpc.dialogs[0], offNotice, codeTs: readFileSync(join(run.work, 'code.ts'), 'utf8') });
    return `plan saved to ${basename(planFile)}; notes.md written, code.ts edit blocked; build dialog offered; /plan off restored tools`;
  } finally {
    writeJsonl(join(out, 'rpc.events.jsonl'), rpc.events);
    await rpc.close();
  }
}

async function driveTodos(run, out) {
  const rpc = startRpc(run);
  try {
    await rpc.prompt(
      script([
        {
          tool: 'TodoWrite',
          args: {
            merge: false,
            todos: [
              { id: 'a', content: 'Alpha', status: 'pending' },
              { id: 'b', content: 'Beta', status: 'pending' },
            ],
          },
        },
      ]),
    );
    const merged = await rpc.prompt(script([{ tool: 'TodoWrite', args: { merge: true, todos: [{ id: 'a', status: 'completed' }] } }]));
    const [result] = toolEnds(merged, 'TodoWrite');
    assert.equal(result?.text, 'Todos (1/2 completed):\n[x] a: Alpha\n[ ] b: Beta');
    const widget = uiRequests(rpc.events, 'setWidget', 'pstack-todos').at(-1);
    assert.deepEqual(widget?.widgetLines, ['Todos 1/2', '✓ Alpha', '○ Beta']);
    // The next turn's system prompt carries the list back to the model.
    const sys = await rpc.prompt('show the prompt\n@@sys');
    const prompt = assistantTexts(sys).at(-1) ?? '';
    assert.match(prompt, /<pstack_todos>[\s\S]*Alpha[\s\S]*Beta[\s\S]*<\/pstack_todos>/);
    writeJson(join(out, 'results.json'), { result: result.text, widget: widget.widgetLines, todosSection: /<pstack_todos>[\s\S]*<\/pstack_todos>/.exec(prompt)?.[0] });
    return 'merge marked Alpha done (1/2), widget shows ✓ Alpha ○ Beta, next turn carries <pstack_todos>';
  } finally {
    writeJsonl(join(out, 'rpc.events.jsonl'), rpc.events);
    await rpc.close();
  }
}

const DRIVES = { 'task-subagents': driveTaskSubagents, 'background-shell': driveBackgroundShell, 'plan-mode': drivePlanMode, todos: driveTodos };

// ---------- commands ----------

function piVersion() {
  return execFileSync('pi', ['--version'], { encoding: 'utf8', env: { ...process.env, PI_SKIP_VERSION_CHECK: '1' } }).trim();
}

async function drive(feature, flags) {
  if (!FEATURES.includes(feature)) throw new Error(`unknown feature ${feature}; expected one of ${FEATURES.join(', ')}`);
  const out = resolve(flags.out ?? join(EVIDENCE_ROOT, feature));
  rmSync(out, { recursive: true, force: true });
  mkdirSync(out, { recursive: true });
  const run = createRun(feature);
  const report = { feature, status: 'FAIL', piVersion: piVersion(), platform: `${process.platform}-${process.arch}`, evidence: out, scratch: flags.keep ? run.root : undefined, summary: '', error: undefined };
  try {
    report.summary = await DRIVES[feature](run, out);
    report.status = 'PASS';
  } catch (error) {
    report.error = error instanceof Error ? error.message : String(error);
  } finally {
    destroyRun(run, flags.keep);
  }
  writeJson(join(out, 'run.json'), report);
  log(JSON.stringify(report, null, 2));
  return report.status === 'PASS';
}

async function doctor() {
  const checks = [];
  const check = async (name, fn) => {
    try {
      checks.push({ name, ok: true, detail: (await fn()) ?? '' });
    } catch (error) {
      checks.push({ name, ok: false, detail: error instanceof Error ? error.message.split('\n')[0] : String(error) });
    }
  };
  await check('node >= 22.21.0 (pi-pstack engines)', () => {
    const [major, minor] = process.versions.node.split('.').map(Number);
    assert.ok(major > 22 || (major === 22 && minor >= 21), process.version);
    return process.version;
  });
  await check('pi on PATH', () => piVersion());
  await check('pi-pstack source and node_modules', () => {
    for (const path of [join(PACKAGE, 'src/index.ts'), join(PACKAGE, 'node_modules/yaml'), SCRIPTED_MODEL]) assert.ok(existsSync(path), `missing ${path} (run bun install --frozen-lockfile)`);
    return PACKAGE;
  });
  await check('pstack tools load with the scripted model', async () => {
    const run = createRun('doctor');
    try {
      const result = await runJson(run, 'list tools\n@@tools-list');
      const tools = (assistantTexts(result.events).at(-1) ?? '').split(',');
      const missing = ['Task', 'agent_status', 'bash_background', 'AwaitShell', 'TodoWrite', 'AskQuestion'].filter((name) => !tools.includes(name));
      assert.deepEqual(missing, [], `missing ${missing.join(', ')}; stderr: ${result.stderr.slice(-300)}`);
      return `${tools.length} tools`;
    } finally {
      destroyRun(run, false);
    }
  });
  await check('no leftover scratch runs', () => {
    const left = readdirSync(tmpdir()).filter((name) => name.startsWith(SCRATCH_PREFIX));
    assert.deepEqual(left, [], `run cleanup to remove ${left.length} run(s)`);
  });
  const inherited = Object.keys(process.env).filter((name) => SCRUB.test(name));
  for (const item of checks) log(`${item.ok ? 'ok  ' : 'FAIL'} ${item.name}${item.detail ? `: ${item.detail}` : ''}`);
  if (inherited.length > 0) log(`note: drives remove these inherited variables: ${inherited.join(', ')}`);
  return checks.every((item) => item.ok);
}

function cleanup() {
  const runs = readdirSync(tmpdir()).filter((name) => name.startsWith(SCRATCH_PREFIX));
  for (const name of runs) {
    const root = join(tmpdir(), name);
    try {
      destroyRun(JSON.parse(readFileSync(join(root, 'run.json'), 'utf8')), false);
    } catch {
      rmSync(root, { recursive: true, force: true });
    }
    log(`removed ${root}`);
  }
  log(`cleaned ${runs.length} scratch run(s); evidence in ${EVIDENCE_ROOT} is kept`);
  return true;
}

function parseFlags(args) {
  const flags = {};
  for (let index = 0; index < args.length; index += 1) {
    if (args[index] === '--keep') flags.keep = true;
    else if (args[index] === '--out') flags.out = args[++index];
    else throw new Error(`unknown flag ${args[index]}`);
  }
  return flags;
}

const [command, ...rest] = process.argv.slice(2);
let ok;
try {
  if (command === 'doctor') ok = await doctor();
  else if (command === 'cleanup') ok = cleanup();
  else if (command === 'drive' && rest[0] !== undefined) ok = await drive(rest[0], parseFlags(rest.slice(1)));
  else {
    log(`usage: control-pstack doctor | drive <${FEATURES.join('|')}> [--out <dir>] [--keep] | cleanup`);
    ok = false;
  }
} catch (error) {
  log(error instanceof Error ? error.message : String(error));
  ok = false;
}
await sleep(0);
process.exit(ok ? 0 : 1);
