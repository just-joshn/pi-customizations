#!/usr/bin/env node
import assert from 'node:assert/strict';
import { execFileSync, spawn } from 'node:child_process';
import { existsSync } from 'node:fs';
import { mkdir, mkdtemp, rm, writeFile } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);
// Root of pi-customizations workspace is 4 levels up: bin -> verify-pi-customizations -> skills -> .pi -> repo root
const REPO_ROOT = resolve(__dirname, '../../../..');

const REQUEST_TIMEOUT_MS = 15000;
const SHUTDOWN_TIMEOUT_MS = 5000;

function parseArgs(args) {
  const [command, ...rest] = args;
  const options = { command, target: rest[0], flags: {} };
  for (let i = 0; i < rest.length; i++) {
    const item = rest[i];
    if (item.startsWith('--')) {
      const key = item.slice(2);
      const next = rest[i + 1];
      if (next && !next.startsWith('--')) {
        options.flags = { ...options.flags, [key]: next };
        i++;
      } else {
        options.flags = { ...options.flags, [key]: true };
      }
    }
  }
  return options;
}

function createRpcSession(packagePath, cwd, extraArgs = []) {
  const child = spawn('pi', ['--mode', 'rpc', '--no-session', '--no-extensions', '-e', packagePath, ...extraArgs], {
    cwd,
    env: { ...process.env, PI_CODING_AGENT_DIR: cwd },
    stdio: ['pipe', 'pipe', 'pipe'],
  });

  const pendingRequests = new Map();
  const uiNotifications = [];
  const entriesAppended = [];
  let stderr = '';
  let requestSeq = 0;
  let closedError = null;

  const onFatalError = (err) => {
    for (const [id, req] of pendingRequests.entries()) {
      clearTimeout(req.timer);
      req.reject(err);
      pendingRequests.delete(id);
    }
  };

  let buffer = '';
  child.stdout.setEncoding('utf8');
  child.stdout.on('data', (chunk) => {
    buffer += chunk;
    let newlineIndex = buffer.indexOf('\n');
    while (newlineIndex >= 0) {
      const line = buffer.slice(0, newlineIndex).trim();
      buffer = buffer.slice(newlineIndex + 1);
      if (line) {
        try {
          const record = JSON.parse(line);
          if (record.type === 'response') {
            const req = pendingRequests.get(record.id);
            if (req) {
              clearTimeout(req.timer);
              pendingRequests.delete(record.id);
              if (record.success) {
                req.resolve(record.data);
              } else {
                req.reject(new Error(record.error ?? 'RPC response indicated failure'));
              }
            }
          } else if (record.type === 'extension_ui_request' && record.method === 'notify') {
            uiNotifications.push({ message: record.message, notifyType: record.notifyType });
          } else if (record.type === 'entry_appended') {
            entriesAppended.push(record.entry);
          }
        } catch (parseErr) {
          // ignore unparseable RPC lines
        }
      }
      newlineIndex = buffer.indexOf('\n');
    }
  });

  child.stderr.setEncoding('utf8');
  child.stderr.on('data', (chunk) => {
    stderr += chunk;
  });

  child.on('error', (err) => {
    onFatalError(err);
  });

  const closePromise = new Promise((resolveClose) => {
    child.once('close', (code, signal) => {
      closedError = new Error(`Pi process exited ${code ?? signal}: ${stderr}`);
      onFatalError(closedError);
      resolveClose(code);
    });
  });

  return {
    send(payload) {
      if (closedError) return Promise.reject(closedError);
      requestSeq += 1;
      const id = `req-${requestSeq}`;
      return new Promise((resolveReq, rejectReq) => {
        const timer = setTimeout(() => {
          pendingRequests.delete(id);
          rejectReq(new Error(`RPC timeout waiting for response to ${payload.type}: ${stderr}`));
        }, REQUEST_TIMEOUT_MS);

        pendingRequests.set(id, { resolve: resolveReq, reject: rejectReq, timer });
        try {
          child.stdin.write(`${JSON.stringify({ id, ...payload })}\n`, (writeErr) => {
            if (writeErr) {
              clearTimeout(timer);
              pendingRequests.delete(id);
              rejectReq(writeErr);
            }
          });
        } catch (err) {
          clearTimeout(timer);
          pendingRequests.delete(id);
          rejectReq(err);
        }
      });
    },
    get notifications() {
      return [...uiNotifications];
    },
    get entries() {
      return [...entriesAppended];
    },
    get stderr() {
      return stderr;
    },
    async close() {
      child.stdin.end();
      const killTimer = setTimeout(() => {
        if (child.exitCode === null && child.signalCode === null) {
          child.kill('SIGKILL');
        }
      }, SHUTDOWN_TIMEOUT_MS);
      try {
        await closePromise;
      } finally {
        clearTimeout(killTimer);
      }
    },
  };
}

async function runDoctor() {
  process.stdout.write('[doctor] Checking environment and Pi CLI...\n');

  // 1. Check Node.js engine
  const nodeVersion = process.versions.node;
  const [major, minor] = nodeVersion.split('.').map(Number);
  const nodeOk = major > 22 || (major === 22 && minor >= 19);
  assert.ok(nodeOk, `Node.js >= 22.19.0 required, current is ${nodeVersion}`);
  process.stdout.write(`✓ Node.js ${nodeVersion} (>= 22.19.0)\n`);

  // 2. Check pi executable on PATH
  let piVersion = '';
  try {
    piVersion = execFileSync('pi', ['--version'], { encoding: 'utf8' }).trim();
    assert.ok(piVersion.length > 0, 'Pi CLI returned empty version');
    process.stdout.write(`✓ Pi CLI executable on PATH (${piVersion})\n`);
  } catch (err) {
    throw new Error(`Failed to execute 'pi --version': ${err.message}`);
  }

  // 3. Check workspace root package
  const pkgJsonPath = join(REPO_ROOT, 'package.json');
  assert.ok(existsSync(pkgJsonPath), `package.json not found at ${pkgJsonPath}`);
  process.stdout.write(`✓ Workspace root verified at ${REPO_ROOT}\n`);

  // 4. Test RPC startup with root package
  const scratchDir = await mkdtemp(join(tmpdir(), 'control-pi-doctor-'));
  try {
    const session = createRpcSession(REPO_ROOT, scratchDir);
    try {
      const res = await session.send({ type: 'get_commands' });
      assert.ok(Array.isArray(res.commands), 'get_commands did not return array of commands');
      process.stdout.write(`✓ Pi RPC initialized with root package (${res.commands.length} commands available)\n`);
    } finally {
      await session.close();
    }
  } finally {
    await rm(scratchDir, { recursive: true, force: true });
  }

  process.stdout.write('[doctor] Doctor check passed cleanly.\n');
}

async function drivePstackStatus(artifactDir) {
  process.stdout.write('[drive:pstack-status] Starting verification...\n');
  const outDir = artifactDir ?? join(REPO_ROOT, 'artifacts/verify-pi-customizations/pstack-status');
  await mkdir(outDir, { recursive: true });

  const scratchDir = await mkdtemp(join(tmpdir(), 'control-pi-status-'));
  const pstackPkg = join(REPO_ROOT, 'extensions/pi-pstack');

  try {
    const session = createRpcSession(pstackPkg, scratchDir);
    try {
      // 1. Issue /pstack status
      await session.send({ type: 'prompt', message: '/pstack status' });
      const msgs = await session.send({ type: 'get_messages' });
      const statusMsgs = msgs.messages.filter((m) => m.role === 'custom' && m.customType === 'pstack-status');
      assert.ok(statusMsgs.length > 0, 'Expected pstack-status message not received');
      const statusContent = String(statusMsgs[0].content);
      assert.match(statusContent, /pstack \d+\.\d+\.\d+/, 'Status did not report pstack version');
      assert.match(statusContent, /team-kit/, 'Status did not report team-kit');
      assert.match(statusContent, /\d+ skills, \d+ prompt templates/, 'Status did not report skills/prompts count');

      await writeFile(join(outDir, 'status.txt'), `${statusContent}\n`, 'utf8');
      await writeFile(join(outDir, 'status.json'), `${JSON.stringify(statusMsgs[0], null, 2)}\n`, 'utf8');

      // 2. Issue /pstack todos
      await session.send({ type: 'prompt', message: '/pstack todos' });
      const msgsAfterTodos = await session.send({ type: 'get_messages' });
      const todosMsgs = msgsAfterTodos.messages.filter((m) => m.role === 'custom' && m.customType === 'pstack-status');
      assert.ok(todosMsgs.length >= 2, 'Expected pstack todos message not received');
      const todosContent = String(todosMsgs[todosMsgs.length - 1].content);
      assert.match(todosContent, /Todos: none\./, 'Expected "Todos: none."');

      await writeFile(join(outDir, 'todos.txt'), `${todosContent}\n`, 'utf8');
      process.stdout.write(`✓ Captured pstack status & todos evidence in ${outDir}\n`);
    } finally {
      await session.close();
    }
  } finally {
    await rm(scratchDir, { recursive: true, force: true });
  }
}

async function drivePotetoMode(artifactDir) {
  process.stdout.write('[drive:poteto-mode] Starting verification...\n');
  const outDir = artifactDir ?? join(REPO_ROOT, 'artifacts/verify-pi-customizations/poteto-mode');
  await mkdir(outDir, { recursive: true });

  const scratchDir = await mkdtemp(join(tmpdir(), 'control-pi-mode-'));
  const pstackPkg = join(REPO_ROOT, 'extensions/pi-pstack');

  try {
    const session = createRpcSession(pstackPkg, scratchDir);
    try {
      await session.send({ type: 'prompt', message: '/poteto-mode off' });
      const notifications = session.notifications;
      assert.ok(
        notifications.some((n) => n.message === 'Poteto mode is off.'),
        'Expected UI notification "Poteto mode is off." not observed',
      );

      const entries = session.entries;
      const stateEntry = entries.find((e) => e.type === 'custom' && e.customType === 'pstack-state');
      assert.ok(stateEntry, 'Expected pstack-state entry appended to branch');
      assert.equal(stateEntry.data?.enabled, false, 'State entry did not reflect enabled: false');

      await writeFile(join(outDir, 'off.txt'), 'Poteto mode is off.\n', 'utf8');
      await writeFile(join(outDir, 'off.json'), `${JSON.stringify({ notifications, stateEntry }, null, 2)}\n`, 'utf8');
      process.stdout.write(`✓ Captured poteto mode off evidence in ${outDir}\n`);
    } finally {
      await session.close();
    }
  } finally {
    await rm(scratchDir, { recursive: true, force: true });
  }
}

async function driveStandaloneSkills(artifactDir) {
  process.stdout.write('[drive:standalone-skills] Starting verification...\n');
  const outDir = artifactDir ?? join(REPO_ROOT, 'artifacts/verify-pi-customizations/standalone-skills');
  await mkdir(outDir, { recursive: true });

  const scratchDir = await mkdtemp(join(tmpdir(), 'control-pi-skills-'));

  try {
    const session = createRpcSession(REPO_ROOT, scratchDir);
    try {
      const res = await session.send({ type: 'get_commands' });
      const skills = res.commands.filter((c) => c.source === 'skill' && c.name.startsWith('skill:')).map((c) => c.name);

      const expected = [
        'skill:doctor',
        'skill:implement-cli-from-contract',
        'skill:reverse-engineer-cli',
        'skill:run',
        'skill:simplify',
      ];

      for (const exp of expected) {
        assert.ok(skills.includes(exp), `Expected standalone skill ${exp} not registered`);
      }

      await writeFile(join(outDir, 'skills.txt'), `${skills.join('\n')}\n`, 'utf8');
      await writeFile(join(outDir, 'skills.json'), `${JSON.stringify(res.commands.filter((c) => c.source === 'skill'), null, 2)}\n`, 'utf8');
      process.stdout.write(`✓ Captured standalone skills evidence in ${outDir} (${skills.length} skills)\n`);
    } finally {
      await session.close();
    }
  } finally {
    await rm(scratchDir, { recursive: true, force: true });
  }
}

async function driveOauthProviders(artifactDir) {
  process.stdout.write('[drive:oauth-providers] Starting verification...\n');
  const outDir = artifactDir ?? join(REPO_ROOT, 'artifacts/verify-pi-customizations/oauth-providers');
  await mkdir(outDir, { recursive: true });

  const scratchDir = await mkdtemp(join(tmpdir(), 'control-pi-oauth-'));
  try {
    const credential = { type: 'oauth', access: 'fixture', refresh: 'fixture', expires: Date.UTC(2100, 0, 1) };
    const auth = {
      'claude-subscription': credential,
      'google-antigravity': { ...credential, projectId: 'fixture-project', email: 'fixture@example.com' },
      'grok-build': credential,
    };
    await writeFile(join(scratchDir, 'auth.json'), JSON.stringify(auth), { mode: 0o600 });

    const claudePkg = join(REPO_ROOT, 'extensions/pi-anthropic-oauth');
    const claudeOutput = execFileSync('pi', ['--no-extensions', '-e', claudePkg, '--list-models', 'claude-subscription'], {
      cwd: scratchDir,
      env: { ...process.env, PI_CODING_AGENT_DIR: scratchDir },
      encoding: 'utf8',
    });
    assert.match(claudeOutput, /claude-subscription\s+claude-opus/, 'Expected claude-subscription models not found');

    const antigravityPkg = join(REPO_ROOT, 'extensions/pi-antigravity-oauth');
    const antigravityOutput = execFileSync('pi', ['--no-extensions', '-e', antigravityPkg, '--list-models', 'google-antigravity'], {
      cwd: scratchDir,
      env: { ...process.env, PI_CODING_AGENT_DIR: scratchDir },
      encoding: 'utf8',
    });
    assert.match(antigravityOutput, /google-antigravity\s+gemini-3-flash-agent/, 'Expected google-antigravity models not found');

    const grokPkg = join(REPO_ROOT, 'extensions/pi-xai-oauth');
    const grokOutput = execFileSync('pi', ['--no-extensions', '-e', grokPkg, '--list-models', 'grok-build'], {
      cwd: scratchDir,
      env: { ...process.env, PI_CODING_AGENT_DIR: scratchDir },
      encoding: 'utf8',
    });
    assert.match(grokOutput, /grok-build\s+grok-4\.7-build-fast/, 'Expected grok-build models not found');

    await writeFile(join(outDir, 'claude-models.txt'), claudeOutput, 'utf8');
    await writeFile(join(outDir, 'antigravity-models.txt'), antigravityOutput, 'utf8');
    await writeFile(join(outDir, 'grok-build-models.txt'), grokOutput, 'utf8');
    process.stdout.write(`✓ Captured OAuth provider model registration evidence in ${outDir}\n`);
  } finally {
    await rm(scratchDir, { recursive: true, force: true });
  }
}

async function drivePiMaintainer(artifactDir) {
  process.stdout.write('[drive:pi-maintainer] Starting verification...\n');
  const outDir = artifactDir ?? join(REPO_ROOT, 'artifacts/verify-pi-customizations/pi-maintainer');
  await mkdir(outDir, { recursive: true });

  const scratchDir = await mkdtemp(join(tmpdir(), 'control-pi-maintainer-'));
  const pkg = join(REPO_ROOT, 'extensions/pi-maintainer');

  try {
    await seedMaintainerRepo(scratchDir);
    await verifyMaintainerRpc(pkg, scratchDir, outDir);
    await verifyMaintainerOneShot(pkg, scratchDir, outDir);
    process.stdout.write(`✓ Captured pi-maintainer evidence in ${outDir}\n`);
  } finally {
    await rm(scratchDir, { recursive: true, force: true });
  }
}

async function seedMaintainerRepo(scratchDir) {
  const git = (args) => execFileSync('git', args, { cwd: scratchDir, encoding: 'utf8' });
  git(['init', '-q', '.']);
  await writeFile(join(scratchDir, 'target.py'), 'value = 1\n', 'utf8');
  git(['add', '.']);
  git(['-c', 'user.email=verify@example.com', '-c', 'user.name=verify', 'commit', '-qm', 'init']);
  await writeFile(join(scratchDir, 'target.py'), 'def broken(\n', 'utf8');
}

async function waitForMessages(session, predicate, description) {
  for (let attempt = 0; attempt < 100; attempt += 1) {
    const result = await session.send({ type: 'get_messages' });
    const match = result.messages.find(predicate);
    if (match) return match;
    await new Promise((resolveWait) => setTimeout(resolveWait, 100));
  }
  throw new Error(`Timed out waiting for ${description}`);
}

async function verifyMaintainerRpc(pkg, scratchDir, outDir) {
  const session = createRpcSession(pkg, scratchDir, ['--yes-always', '--lint-cmd', 'echo target.py:1:1: CUSTOM-LINT-FAILURE; false']);
  try {
    const commands = await session.send({ type: 'get_commands' });
    const maintainer = commands.commands
      .filter((command) => command.source === 'extension' && ['lint', 'test', 'run'].includes(command.name))
      .map((command) => command.name)
      .toSorted();
    assert.deepEqual(maintainer, ['lint', 'run', 'test'], 'Expected the three maintainer commands to be registered');

    await session.send({ type: 'prompt', message: '/lint' });
    const lintText = await waitForNotifications(session, (message) => message.includes('# Fix any errors below'), 'the lint failure text');
    assert.match(lintText, /## Running: echo target\.py:1:1: CUSTOM-LINT-FAILURE; false target\.py/, 'Expected the configured checker command line');
    assert.match(lintText, /target\.py:1:1: CUSTOM-LINT-FAILURE/, 'Expected the checker output');
    assert.match(lintText, /## See relevant line below marked with █/, 'Expected the single marked-line heading');
    assert.match(lintText, /  1█def broken\(/, 'Expected the marked source line');
    await writeFile(join(outDir, 'lint.txt'), `${lintText}\n`, 'utf8');

    await session.send({ type: 'prompt', message: "/test printf 'FAILED test_x\\n'; exit 1" });
    const failure = await waitForMessages(session, (message) => message.role === 'custom' && message.customType === 'maintainer-command-output', 'the added test output');
    const expected = "I ran this command:\n\nprintf 'FAILED test_x\\n'; exit 1\n\nAnd got this output:\n\nFAILED test_x\n\n";
    assert.equal(failure.content, expected, 'Expected the exact run-output message');
    // The second copy of the failure text is delivered as the next user turn by the session's
    // own prompt path, which needs a reachable model, so this drive only records the first copy.
    await writeFile(join(outDir, 'test-failure-message.json'), `${JSON.stringify(failure, null, 2)}\n`, 'utf8');

    await session.send({ type: 'prompt', message: '/run echo HELLO' });
    const runMessage = await waitForMessages(
      session,
      (message) => message.role === 'custom' && message.customType === 'maintainer-command-output' && String(message.content).includes('echo HELLO'),
      'the added run output',
    );
    assert.equal(runMessage.content, 'I ran this command:\n\necho HELLO\n\nAnd got this output:\n\nHELLO\n\n', 'Expected the exact run-output message');
    await writeFile(join(outDir, 'run-message.json'), `${JSON.stringify(runMessage, null, 2)}\n`, 'utf8');
    await writeFile(join(outDir, 'notifications.json'), `${JSON.stringify(session.notifications, null, 2)}\n`, 'utf8');
  } finally {
    await session.close();
  }
}

async function waitForNotifications(session, predicate, description) {
  for (let attempt = 0; attempt < 100; attempt += 1) {
    const match = session.notifications.map((notification) => notification.message).find(predicate);
    if (match) return match;
    await new Promise((resolveWait) => setTimeout(resolveWait, 100));
  }
  throw new Error(`Timed out waiting for ${description}`);
}

function runPiMaintainerCli(pkg, scratchDir, args) {
  try {
    const stdout = execFileSync('pi', ['--no-session', '--no-extensions', '-e', pkg, ...args], {
      cwd: scratchDir,
      env: { ...process.env, PI_CODING_AGENT_DIR: scratchDir },
      encoding: 'utf8',
    });
    return { status: 0, stdout };
  } catch (error) {
    return { status: error.status ?? 1, stdout: `${error.stdout ?? ''}${error.stderr ?? ''}` };
  }
}

async function verifyMaintainerOneShot(pkg, scratchDir, outDir) {
  // One-shot flags are read at process start, so each check runs a real pi process.
  // Exit codes come from the default mode: RPC mode exits 0 by its own design.
  const ranPath = join(scratchDir, 'ran.txt');
  const failing = runPiMaintainerCli(pkg, scratchDir, ['--test', '--test-cmd', `date > ${ranPath}; printf 'FAILED test_x\n'; exit 1`]);
  assert.equal(failing.status, 0, 'A failing one-shot test must still exit 0');
  assert.ok(existsSync(ranPath), 'Expected the test command to run');

  const missing = runPiMaintainerCli(pkg, scratchDir, ['--test']);
  assert.equal(missing.status, 1, 'A one-shot test without a command must exit 1');

  const badFlag = runPiMaintainerCli(pkg, scratchDir, ['--lint', '--lint-cmd', 'rust:']);
  assert.equal(badFlag.status, 1, 'An unparsable lint command must exit 1');

  const summary = [
    `one-shot --test failing: exit ${failing.status}, command ran: ${existsSync(ranPath)}`,
    `one-shot --test without --test-cmd: exit ${missing.status}`,
    `--lint with an unparsable --lint-cmd: exit ${badFlag.status}`,
  ].join('\n');
  await writeFile(join(outDir, 'one-shot.txt'), `${summary}\n`, 'utf8');
}

async function main() {
  const { command, target, flags } = parseArgs(process.argv.slice(2));

  try {
    if (command === 'doctor') {
      await runDoctor();
    } else if (command === 'drive') {
      const feature = target || flags.feature;
      const artifactDir = flags['artifact-dir'] || flags.out;
      if (feature === 'pstack-status') {
        await drivePstackStatus(artifactDir);
      } else if (feature === 'poteto-mode') {
        await drivePotetoMode(artifactDir);
      } else if (feature === 'standalone-skills') {
        await driveStandaloneSkills(artifactDir);
      } else if (feature === 'oauth-providers') {
        await driveOauthProviders(artifactDir);
      } else if (feature === 'pi-maintainer') {
        await drivePiMaintainer(artifactDir);
      } else {
        throw new Error(`Unknown feature to drive: '${feature}'. Expected: pstack-status, poteto-mode, standalone-skills, oauth-providers, pi-maintainer`);
      }
    } else {
      process.stdout.write(`Usage:
  control-pi doctor
  control-pi drive <pstack-status | poteto-mode | standalone-skills | oauth-providers | pi-maintainer> [--out <dir>]
`);
      process.exit(1);
    }
  } catch (err) {
    process.stderr.write(`[control-pi error] ${err.message}\n`);
    process.exit(1);
  }
}

await main();
