#!/usr/bin/env node
import assert from 'node:assert/strict';
import { execFileSync } from 'node:child_process';
import { existsSync } from 'node:fs';
import { mkdir, mkdtemp, readdir, rm } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

import { createReceipts } from '../lib/receipts.mjs';
import { createRpcSession } from '../lib/rpc.mjs';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);
// Root of pi-customizations workspace is 4 levels up: bin -> verify-pi-customizations -> skills -> .pi -> repo root
const REPO_ROOT = resolve(__dirname, '../../../..');
const SCENARIOS_DIR = resolve(__dirname, '../scenarios');
const ARTIFACTS_ROOT = join(REPO_ROOT, 'artifacts/user-perspective');
const SCENARIO_NAME_PATTERN = /^[a-z0-9][a-z0-9-]*$/;

function parseArgs(args) {
  const [command, ...rest] = args;
  const options = { command, target: rest[0], flags: {} };
  for (let i = 0; i < rest.length; i++) {
    const item = rest[i];
    if (item.startsWith('--')) {
      const key = item.slice(2);
      const next = rest[i + 1];
      if (next && !next.startsWith('--')) {
        options.flags = { ...options.flags, [key]: next };
        i++;
      } else {
        options.flags = { ...options.flags, [key]: true };
      }
    }
  }
  return options;
}

function piBin() {
  return process.env.PI_BIN ?? 'pi';
}

async function scenarioNames() {
  const entries = await readdir(SCENARIOS_DIR).catch(() => []);
  return entries
    .filter((name) => name.endsWith('.mjs'))
    .map((name) => name.slice(0, -4))
    .sort();
}

function runDoctorChecks() {
  const [major, minor] = process.versions.node.split('.').map(Number);
  assert.ok(major > 22 || (major === 22 && minor >= 19), `Node.js >= 22.19.0 required, current is ${process.versions.node}`);
  process.stdout.write(`✓ Node.js ${process.versions.node} (>= 22.19.0)\n`);

  let version = '';
  try {
    version = execFileSync(piBin(), ['--version'], { encoding: 'utf8' }).trim();
  } catch (error) {
    throw new Error(`Failed to execute 'pi --version': ${error.message}`);
  }
  assert.ok(version.length > 0, 'Pi CLI returned empty version');
  process.stdout.write(`✓ Pi CLI executable on PATH (${version})\n`);

  const pkgJsonPath = join(REPO_ROOT, 'package.json');
  assert.ok(existsSync(pkgJsonPath), `package.json not found at ${pkgJsonPath}`);
  process.stdout.write(`✓ Workspace root verified at ${REPO_ROOT}\n`);
}

async function runDoctor() {
  process.stdout.write('[doctor] Checking environment and Pi CLI...\n');
  runDoctorChecks();

  const scratchDir = await mkdtemp(join(tmpdir(), 'control-pi-doctor-'));
  try {
    const session = createRpcSession({ packagePath: REPO_ROOT, agentDir: scratchDir, capturePath: join(scratchDir, 'doctor-rpc.jsonl') });
    try {
      const commands = await session.commands();
      assert.ok(Array.isArray(commands), 'get_commands did not return array of commands');
      process.stdout.write(`✓ Pi RPC initialized with root package (${commands.length} commands available)\n`);
    } finally {
      await session.close();
    }
  } finally {
    await rm(scratchDir, { recursive: true, force: true });
  }

  process.stdout.write('[doctor] Doctor check passed cleanly.\n');
}

function createContext({ scenario, artifactDir, rawDir, scratchDir, receipts }) {
  const sessions = [];
  let sessionCount = 0;
  return {
    scenario,
    repoRoot: REPO_ROOT,
    artifactDir,
    rawDir,
    scratchDir,
    receipts,
    piBin: piBin(),
    log(message) {
      process.stdout.write(`${message}\n`);
    },
    rawPath(name) {
      return join(rawDir, name);
    },
    startSession(options = {}) {
      sessionCount += 1;
      const session = createRpcSession({
        packagePath: options.packagePath ?? REPO_ROOT,
        agentDir: scratchDir,
        cwd: options.cwd ?? scratchDir,
        capturePath: options.capturePath ?? join(rawDir, options.captureName ?? `rpc-${sessionCount}.jsonl`),
        persistSession: options.persistSession ?? false,
        sessionId: options.sessionId,
        answers: options.answers,
        requestTimeoutMs: options.requestTimeoutMs,
        idleTimeoutMs: options.idleTimeoutMs,
        piBin: piBin(),
      });
      sessions.push(session);
      return session;
    },
    runPi(args, options = {}) {
      return execFileSync(piBin(), args, {
        cwd: options.cwd ?? scratchDir,
        env: { ...process.env, ...options.env, PI_CODING_AGENT_DIR: options.agentDir ?? scratchDir },
        encoding: 'utf8',
        timeout: options.timeoutMs ?? 60000,
      });
    },
    async closeSessions() {
      await Promise.all(sessions.map((session) => session.close().catch(() => {})));
    },
  };
}

async function drive(name, outDir) {
  const available = await scenarioNames();
  if (!name) throw new Error(`Missing scenario name. Available scenarios: ${available.join(', ')}`);
  if (!SCENARIO_NAME_PATTERN.test(name) || !available.includes(name)) {
    throw new Error(`Unknown scenario '${name}'. Available scenarios: ${available.join(', ')}`);
  }

  const scenarioPath = join(SCENARIOS_DIR, `${name}.mjs`);
  const artifactDir = outDir ? resolve(REPO_ROOT, outDir) : join(ARTIFACTS_ROOT, name);
  const rawDir = join(artifactDir, 'raw');
  await mkdir(rawDir, { recursive: true });

  const receipts = createReceipts({ scenario: name, artifactsRoot: ARTIFACTS_ROOT, receiptDir: artifactDir, repoRoot: REPO_ROOT });
  const scratchDir = await mkdtemp(join(tmpdir(), `control-pi-${name}-`));
  const context = createContext({ scenario: name, artifactDir, rawDir, scratchDir, receipts });
  process.stdout.write(`[drive:${name}] Starting verification...\n`);
  try {
    const module = await import(pathToFileURL(scenarioPath).href);
    if (typeof module.default !== 'function') throw new Error(`Scenario ${name} must export a default async function`);
    await module.default(context);
  } finally {
    await context.closeSessions();
    await rm(scratchDir, { recursive: true, force: true });
  }

  const failed = receipts.failed();
  if (failed.length > 0) throw new Error(`Scenario ${name} wrote ${failed.length} failed receipt(s): ${failed.map((receipt) => receipt.surface_id).join(', ')}`);
  process.stdout.write(`✓ Scenario ${name} wrote ${receipts.receipts().length} receipt(s) to ${artifactDir}\n`);
}

async function main() {
  const { command, target, flags } = parseArgs(process.argv.slice(2));

  try {
    if (command === 'doctor') {
      await runDoctor();
    } else if (command === 'drive') {
      await drive(target || flags.feature, flags['artifact-dir'] || flags.out);
    } else {
      process.stdout.write(`Usage:
  control-pi doctor
  control-pi drive <name> [--out <dir>]

Scenarios:
  ${(await scenarioNames()).join('\n  ')}
`);
      process.exit(1);
    }
  } catch (error) {
    process.stderr.write(`[control-pi error] ${error.message}\n`);
    process.exit(1);
  }
}

await main();
