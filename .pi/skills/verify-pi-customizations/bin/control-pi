#!/usr/bin/env node
import assert from 'node:assert/strict';
import { execFileSync, spawn } from 'node:child_process';
import { existsSync } from 'node:fs';
import { mkdir, mkdtemp, rm, writeFile } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);
// Root of pi-customizations workspace is 4 levels up: bin -> verify-pi-customizations -> skills -> .pi -> repo root
const REPO_ROOT = resolve(__dirname, '../../../..');

const REQUEST_TIMEOUT_MS = 15000;
const SHUTDOWN_TIMEOUT_MS = 5000;

function parseArgs(args) {
  const [command, ...rest] = args;
  const options = { command, target: rest[0], flags: {} };
  for (let i = 0; i < rest.length; i++) {
    const item = rest[i];
    if (item.startsWith('--')) {
      const key = item.slice(2);
      const next = rest[i + 1];
      if (next && !next.startsWith('--')) {
        options.flags = { ...options.flags, [key]: next };
        i++;
      } else {
        options.flags = { ...options.flags, [key]: true };
      }
    }
  }
  return options;
}

function createRpcSession(packagePath, cwd) {
  const child = spawn('pi', ['--mode', 'rpc', '--no-session', '--no-extensions', '-e', packagePath], {
    cwd,
    env: { ...process.env, PI_CODING_AGENT_DIR: cwd },
    stdio: ['pipe', 'pipe', 'pipe'],
  });

  const pendingRequests = new Map();
  const uiNotifications = [];
  const entriesAppended = [];
  let stderr = '';
  let requestSeq = 0;
  let closedError = null;

  const onFatalError = (err) => {
    for (const [id, req] of pendingRequests.entries()) {
      clearTimeout(req.timer);
      req.reject(err);
      pendingRequests.delete(id);
    }
  };

  let buffer = '';
  child.stdout.setEncoding('utf8');
  child.stdout.on('data', (chunk) => {
    buffer += chunk;
    let newlineIndex = buffer.indexOf('\n');
    while (newlineIndex >= 0) {
      const line = buffer.slice(0, newlineIndex).trim();
      buffer = buffer.slice(newlineIndex + 1);
      if (line) {
        try {
          const record = JSON.parse(line);
          if (record.type === 'response') {
            const req = pendingRequests.get(record.id);
            if (req) {
              clearTimeout(req.timer);
              pendingRequests.delete(record.id);
              if (record.success) {
                req.resolve(record.data);
              } else {
                req.reject(new Error(record.error ?? 'RPC response indicated failure'));
              }
            }
          } else if (record.type === 'extension_ui_request' && record.method === 'notify') {
            uiNotifications.push({ message: record.message, notifyType: record.notifyType });
          } else if (record.type === 'entry_appended') {
            entriesAppended.push(record.entry);
          }
        } catch (parseErr) {
          // ignore unparseable RPC lines
        }
      }
      newlineIndex = buffer.indexOf('\n');
    }
  });

  child.stderr.setEncoding('utf8');
  child.stderr.on('data', (chunk) => {
    stderr += chunk;
  });

  child.on('error', (err) => {
    onFatalError(err);
  });

  const closePromise = new Promise((resolveClose) => {
    child.once('close', (code, signal) => {
      closedError = new Error(`Pi process exited ${code ?? signal}: ${stderr}`);
      onFatalError(closedError);
      resolveClose(code);
    });
  });

  return {
    send(payload) {
      if (closedError) return Promise.reject(closedError);
      requestSeq += 1;
      const id = `req-${requestSeq}`;
      return new Promise((resolveReq, rejectReq) => {
        const timer = setTimeout(() => {
          pendingRequests.delete(id);
          rejectReq(new Error(`RPC timeout waiting for response to ${payload.type}: ${stderr}`));
        }, REQUEST_TIMEOUT_MS);

        pendingRequests.set(id, { resolve: resolveReq, reject: rejectReq, timer });
        try {
          child.stdin.write(`${JSON.stringify({ id, ...payload })}\n`, (writeErr) => {
            if (writeErr) {
              clearTimeout(timer);
              pendingRequests.delete(id);
              rejectReq(writeErr);
            }
          });
        } catch (err) {
          clearTimeout(timer);
          pendingRequests.delete(id);
          rejectReq(err);
        }
      });
    },
    get notifications() {
      return [...uiNotifications];
    },
    get entries() {
      return [...entriesAppended];
    },
    get stderr() {
      return stderr;
    },
    async close() {
      child.stdin.end();
      const killTimer = setTimeout(() => {
        if (child.exitCode === null && child.signalCode === null) {
          child.kill('SIGKILL');
        }
      }, SHUTDOWN_TIMEOUT_MS);
      try {
        await closePromise;
      } finally {
        clearTimeout(killTimer);
      }
    },
  };
}

async function runDoctor() {
  process.stdout.write('[doctor] Checking environment and Pi CLI...\n');

  // 1. Check Node.js engine
  const nodeVersion = process.versions.node;
  const [major, minor] = nodeVersion.split('.').map(Number);
  const nodeOk = major > 22 || (major === 22 && minor >= 19);
  assert.ok(nodeOk, `Node.js >= 22.19.0 required, current is ${nodeVersion}`);
  process.stdout.write(`✓ Node.js ${nodeVersion} (>= 22.19.0)\n`);

  // 2. Check pi executable on PATH
  let piVersion = '';
  try {
    piVersion = execFileSync('pi', ['--version'], { encoding: 'utf8' }).trim();
    assert.ok(piVersion.length > 0, 'Pi CLI returned empty version');
    process.stdout.write(`✓ Pi CLI executable on PATH (${piVersion})\n`);
  } catch (err) {
    throw new Error(`Failed to execute 'pi --version': ${err.message}`);
  }

  // 3. Check workspace root package
  const pkgJsonPath = join(REPO_ROOT, 'package.json');
  assert.ok(existsSync(pkgJsonPath), `package.json not found at ${pkgJsonPath}`);
  process.stdout.write(`✓ Workspace root verified at ${REPO_ROOT}\n`);

  // 4. Test RPC startup with root package
  const scratchDir = await mkdtemp(join(tmpdir(), 'control-pi-doctor-'));
  try {
    const session = createRpcSession(REPO_ROOT, scratchDir);
    try {
      const res = await session.send({ type: 'get_commands' });
      assert.ok(Array.isArray(res.commands), 'get_commands did not return array of commands');
      process.stdout.write(`✓ Pi RPC initialized with root package (${res.commands.length} commands available)\n`);
    } finally {
      await session.close();
    }
  } finally {
    await rm(scratchDir, { recursive: true, force: true });
  }

  process.stdout.write('[doctor] Doctor check passed cleanly.\n');
}

async function drivePstackCommands(artifactDir) {
  process.stdout.write('[drive:pstack-commands] Starting verification...\n');
  const outDir = artifactDir ?? join(REPO_ROOT, 'artifacts/verify-pi-customizations/pstack-commands');
  await mkdir(outDir, { recursive: true });

  const scratchDir = await mkdtemp(join(tmpdir(), 'control-pi-commands-'));
  const pstackPkg = join(REPO_ROOT, 'extensions/pi-pstack-two');

  try {
    const session = createRpcSession(pstackPkg, scratchDir);
    try {
      // 1. Extension surface: /mode and /loop are registered, pstack skills are loadable.
      const res = await session.send({ type: 'get_commands' });
      const names = res.commands.map((c) => c.name);
      for (const expected of ['mode', 'loop']) {
        assert.ok(names.includes(expected), `Expected extension command /${expected} not registered`);
      }
      for (const expected of ['skill:poteto-mode', 'skill:setup-pstack', 'skill:poteto-help']) {
        assert.ok(names.includes(expected), `Expected pstack skill ${expected} not registered`);
      }
      await writeFile(join(outDir, 'commands.json'), `${JSON.stringify(res.commands, null, 2)}\n`, 'utf8');

      // 2. /mode with no mode on reports through a UI notification.
      await session.send({ type: 'prompt', message: '/mode' });
      assert.ok(
        session.notifications.some((n) => n.message === 'No Custom Mode is on.'),
        'Expected UI notification "No Custom Mode is on." not observed',
      );
      await writeFile(join(outDir, 'mode-status.txt'), 'No Custom Mode is on.\n', 'utf8');
      process.stdout.write(`✓ Captured pstack command-surface evidence in ${outDir}\n`);
    } finally {
      await session.close();
    }
  } finally {
    await rm(scratchDir, { recursive: true, force: true });
  }
}

async function drivePotetoMode(artifactDir) {
  process.stdout.write('[drive:poteto-mode] Starting verification...\n');
  const outDir = artifactDir ?? join(REPO_ROOT, 'artifacts/verify-pi-customizations/poteto-mode');
  await mkdir(outDir, { recursive: true });

  const scratchDir = await mkdtemp(join(tmpdir(), 'control-pi-mode-'));
  const pstackPkg = join(REPO_ROOT, 'extensions/pi-pstack-two');

  try {
    const session = createRpcSession(pstackPkg, scratchDir);
    try {
      // 1. Turn the mode on.
      await session.send({ type: 'prompt', message: '/mode poteto-mode' });
      assert.ok(
        session.notifications.some((n) => n.message === 'Custom Mode on: poteto-mode. /mode off exits.'),
        'Expected UI notification "Custom Mode on: poteto-mode. /mode off exits." not observed',
      );
      const onEntry = session.entries.find((e) => e.type === 'custom' && e.customType === 'pstack-two/mode');
      assert.ok(onEntry, 'Expected pstack-two/mode entry appended to branch');
      assert.equal(onEntry.data?.skill, 'poteto-mode', 'On entry did not record the poteto-mode skill');

      // 2. Turn the mode off.
      const beforeOff = session.notifications.length;
      await session.send({ type: 'prompt', message: '/mode off' });
      assert.ok(
        session.notifications.slice(beforeOff).some((n) => n.message === 'Custom Mode off.'),
        'Expected UI notification "Custom Mode off." not observed',
      );
      const offEntry = session.entries.filter((e) => e.type === 'custom' && e.customType === 'pstack-two/mode').at(-1);
      assert.ok(offEntry, 'Expected a second pstack-two/mode entry appended to branch');
      assert.equal(offEntry.data, null, 'Off entry did not record null mode data');

      await writeFile(
        join(outDir, 'mode.json'),
        `${JSON.stringify({ notifications: session.notifications, entries: session.entries }, null, 2)}\n`,
        'utf8',
      );
      process.stdout.write(`✓ Captured poteto mode on/off evidence in ${outDir}\n`);
    } finally {
      await session.close();
    }
  } finally {
    await rm(scratchDir, { recursive: true, force: true });
  }
}

async function driveStandaloneSkills(artifactDir) {
  process.stdout.write('[drive:standalone-skills] Starting verification...\n');
  const outDir = artifactDir ?? join(REPO_ROOT, 'artifacts/verify-pi-customizations/standalone-skills');
  await mkdir(outDir, { recursive: true });

  const scratchDir = await mkdtemp(join(tmpdir(), 'control-pi-skills-'));

  try {
    const session = createRpcSession(REPO_ROOT, scratchDir);
    try {
      const res = await session.send({ type: 'get_commands' });
      const skills = res.commands.filter((c) => c.source === 'skill' && c.name.startsWith('skill:')).map((c) => c.name);

      const expected = ['skill:port-harness-capability'];

      for (const exp of expected) {
        assert.ok(skills.includes(exp), `Expected standalone skill ${exp} not registered`);
      }

      await writeFile(join(outDir, 'skills.txt'), `${skills.join('\n')}\n`, 'utf8');
      await writeFile(join(outDir, 'skills.json'), `${JSON.stringify(res.commands.filter((c) => c.source === 'skill'), null, 2)}\n`, 'utf8');
      process.stdout.write(`✓ Captured standalone skills evidence in ${outDir} (${skills.length} skills)\n`);
    } finally {
      await session.close();
    }
  } finally {
    await rm(scratchDir, { recursive: true, force: true });
  }
}

async function driveOauthProviders(artifactDir) {
  process.stdout.write('[drive:oauth-providers] Starting verification...\n');
  const outDir = artifactDir ?? join(REPO_ROOT, 'artifacts/verify-pi-customizations/oauth-providers');
  await mkdir(outDir, { recursive: true });

  const scratchDir = await mkdtemp(join(tmpdir(), 'control-pi-oauth-'));
  try {
    const credential = { type: 'oauth', access: 'fixture', refresh: 'fixture', expires: Date.UTC(2100, 0, 1) };
    const auth = {
      'claude-subscription': credential,
      'google-antigravity': { ...credential, projectId: 'fixture-project', email: 'fixture@example.com' },
      'grok-build': credential,
    };
    await writeFile(join(scratchDir, 'auth.json'), JSON.stringify(auth), { mode: 0o600 });

    const claudePkg = join(REPO_ROOT, 'extensions/pi-anthropic-oauth');
    const claudeOutput = execFileSync('pi', ['--no-extensions', '-e', claudePkg, '--list-models', 'claude-subscription'], {
      cwd: scratchDir,
      env: { ...process.env, PI_CODING_AGENT_DIR: scratchDir },
      encoding: 'utf8',
    });
    assert.match(claudeOutput, /claude-subscription\s+claude-opus/, 'Expected claude-subscription models not found');

    const antigravityPkg = join(REPO_ROOT, 'extensions/pi-antigravity-oauth');
    const antigravityOutput = execFileSync('pi', ['--no-extensions', '-e', antigravityPkg, '--list-models', 'google-antigravity'], {
      cwd: scratchDir,
      env: { ...process.env, PI_CODING_AGENT_DIR: scratchDir },
      encoding: 'utf8',
    });
    assert.match(antigravityOutput, /google-antigravity\s+gemini-/, 'Expected google-antigravity models not found');

    const grokPkg = join(REPO_ROOT, 'extensions/pi-xai-oauth');
    const grokOutput = execFileSync('pi', ['--no-extensions', '-e', grokPkg, '--list-models', 'grok-build'], {
      cwd: scratchDir,
      env: { ...process.env, PI_CODING_AGENT_DIR: scratchDir },
      encoding: 'utf8',
    });
    assert.match(grokOutput, /grok-build\s+grok-4\.7-build-fast/, 'Expected grok-build models not found');

    await writeFile(join(outDir, 'claude-models.txt'), claudeOutput, 'utf8');
    await writeFile(join(outDir, 'antigravity-models.txt'), antigravityOutput, 'utf8');
    await writeFile(join(outDir, 'grok-build-models.txt'), grokOutput, 'utf8');
    process.stdout.write(`✓ Captured OAuth provider model registration evidence in ${outDir}\n`);
  } finally {
    await rm(scratchDir, { recursive: true, force: true });
  }
}

async function main() {
  const { command, target, flags } = parseArgs(process.argv.slice(2));

  try {
    if (command === 'doctor') {
      await runDoctor();
    } else if (command === 'drive') {
      const feature = target || flags.feature;
      const artifactDir = flags['artifact-dir'] || flags.out;
      if (feature === 'pstack-commands') {
        await drivePstackCommands(artifactDir);
      } else if (feature === 'poteto-mode') {
        await drivePotetoMode(artifactDir);
      } else if (feature === 'standalone-skills') {
        await driveStandaloneSkills(artifactDir);
      } else if (feature === 'oauth-providers') {
        await driveOauthProviders(artifactDir);
      } else {
        throw new Error(`Unknown feature to drive: '${feature}'. Expected: pstack-commands, poteto-mode, standalone-skills, oauth-providers`);
      }
    } else {
      process.stdout.write(`Usage:
  control-pi doctor
  control-pi drive <pstack-commands | poteto-mode | standalone-skills | oauth-providers> [--out <dir>]
`);
      process.exit(1);
    }
  } catch (err) {
    process.stderr.write(`[control-pi error] ${err.message}\n`);
    process.exit(1);
  }
}

await main();
